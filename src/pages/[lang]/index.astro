---
/**
 * The landing page, one route per locale.
 *
 * The page makes one argument: getting the card through us is fast and takes
 * almost no effort. The hero states the outcome and the effort; the two-audience
 * columns show who it is for and, structurally, both directions of the crossing;
 * eligibility gates honestly before anyone compares prices; the tiers are the
 * choice; the process is the five steps, with the payoff called out.
 *
 * <BridgeSpan> occupies each gap between sections, so the connecting line is
 * unbroken from the hero to the footer — and it passes exactly between the two
 * audience columns, which is the one place its meaning becomes legible.
 */
import Base from '../../layouts/Base.astro';
import SloganBand from '../../components/SloganBand.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import DisclosureBand from '../../components/DisclosureBand.astro';
import Audiences from '../../components/Audiences.astro';
import ApplePay from '../../components/ApplePay.astro';
import Eligibility from '../../components/Eligibility.astro';
import Tiers from '../../components/Tiers.astro';
import Process from '../../components/Process.astro';
import Faq from '../../components/Faq.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Footer from '../../components/Footer.astro';
import BridgeSpan from '../../components/BridgeSpan.astro';
import { LOCALES, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = t(locale);
---

<Base locale={locale}>
  <SloganBand locale={locale} />
  <Nav locale={locale} />

  <main id="main" aria-label={copy.a11y.mainLabel}>
    <Hero locale={locale} />
    <BridgeSpan />
    <DisclosureBand locale={locale} />
    <BridgeSpan />
    <Audiences locale={locale} />
    <BridgeSpan />
    <ApplePay locale={locale} />
    <BridgeSpan />
    <Eligibility locale={locale} />
    <BridgeSpan />
    <Tiers locale={locale} />
    <BridgeSpan />
    <Process locale={locale} />
    <BridgeSpan />
    <Faq locale={locale} />
    <BridgeSpan />
    <ClosingCta locale={locale} />
    <BridgeSpan />
  </main>

  <Footer locale={locale} />
</Base>
