---
/**
 * The landing page, one route per locale.
 *
 * The page makes one argument: two documents and the card is yours. The hero
 * states it and lets the reader compare plans; the benefits show what the card
 * pays for; the plans are the choice; the process is three steps.
 *
 * <BridgeSpan> occupies each gap between sections, so the connecting line runs
 * unbroken from the hero to the footer — and passes exactly between the two
 * benefit columns, which is the one place its meaning becomes legible.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Accounts from '../../components/Accounts.astro';
import Benefits from '../../components/Benefits.astro';
import Tiers from '../../components/Tiers.astro';
import Process from '../../components/Process.astro';
import Faq from '../../components/Faq.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import Footer from '../../components/Footer.astro';
import BridgeSpan from '../../components/BridgeSpan.astro';
import { LOCALES, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = t(locale);
---

<Base locale={locale}>
  <Nav locale={locale} />

  <main id="main" aria-label={copy.a11y.mainLabel}>
    <Hero locale={locale} />
    <BridgeSpan />
    <Accounts locale={locale} />
    <BridgeSpan />
    <Benefits locale={locale} />
    <BridgeSpan />
    <Tiers locale={locale} />
    <BridgeSpan />
    <Process locale={locale} />
    <BridgeSpan />
    <Faq locale={locale} />
    <BridgeSpan />
    <ClosingCta locale={locale} />
    <BridgeSpan />
  </main>

  <Footer locale={locale} />
</Base>
