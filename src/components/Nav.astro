---
/**
 * Sticky header, stripped to the four things it needs: the wordmark, the
 * language switch, sign in, and the one primary action.
 *
 * There are no section links. The page is short enough to scroll and every
 * link that used to live here now sits in the footer, so the header stays a
 * single uncluttered line at every width — which also means no hamburger is
 * needed and no nav JavaScript ships at all.
 */
import { Image } from 'astro:assets';
import { t, otherLocale, localePath, type Locale } from '../i18n';
import logo from '../assets/logo-lockup.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const other = otherLocale(locale);
const otherCopy = t(other);
---

<header class="nav">
  <div class="nav-inner">
    {/* The lockup carries the word "getcard" as artwork, so alt does the
        naming — it is read aloud and is what shows if the image never loads.
        No extra visually-hidden label: that made it announce twice.
        densities={[1, 2]} ships a 2x file for retina. */}
    <a class="wordmark" href={localePath(locale)}>
      <Image src={logo} alt={copy.nav.wordmark} densities={[1, 2]} loading="eager" />
    </a>

    <div class="nav-actions">
      <a class="lang-switch" href={localePath(other)} hreflang={other} lang={other}>
        <span class="lang-label">{copy.nav.languageLabel}</span>
        <span class="lang-code">{otherCopy.meta.localeShort}</span>
      </a>

      {/* Tracking is a separate app on its own subdomain, so this is a full URL
          rather than a route in this build. There is no account to sign into:
          an order returns a tracking number, and that number is the only key. */}
      <a class="pill-outlined nav-track" href="https://app.getcard.kg/track">{copy.nav.track}</a>

      {/* The first decision is which plan, so the primary action goes there. */}
      <a class="pill-filled nav-cta" href="#tiers">{copy.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-hairline);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    text-decoration: none;
  }

  /* Height-locked: the lockup is a fixed band in the header and the width
     follows from the artwork, so the header never reflows when the image
     lands. */
  .wordmark img {
    height: 30px;
    width: auto;
    display: block;
  }

  @media (max-width: 520px) {
    .wordmark img {
      height: 24px;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    min-width: 0;
  }

  .lang-switch {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 4px;
    font-size: var(--text-body-sm);
    color: var(--color-graphite);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-switch:hover .lang-code {
    color: var(--color-link);
  }

  .lang-code {
    font-weight: 600;
  }

  /* The label is the first thing worth dropping when width runs out — the
     language code alone is still unambiguous. */
  @media (max-width: 600px) {
    .lang-label {
      display: none;
    }
  }

  /* Header pills sit a step smaller than the body pills so the bar keeps its
     8px padding. Padding, never width: Russian labels are longer and must set
     their own size. */
  .nav-actions .pill-outlined,
  .nav-actions .pill-filled {
    font-size: var(--text-body-sm);
    padding: 7px 14px;
    white-space: nowrap;
  }

  /* Below 420px the primary action alone is worth the space; sign in stays
     reachable from the page itself once auth exists. */
  @media (max-width: 420px) {
    .nav-track {
      display: none;
    }

    .nav-inner {
      padding-inline: 16px;
    }
  }
</style>
