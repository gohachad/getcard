---
/**
 * Renders a copy string, turning marker sentinels inside it into visible
 * markers rather than letting them read as ordinary text.
 *
 *   [TBD]    — a value that is not decided yet
 *   [VERIFY] — a figure shown but not confirmed with the bank
 *
 * Markers are interpolated mid-sentence in the locale files ("$20 [VERIFY]",
 * "Способы оплаты: [TBD]."), so they have to survive inside a string. Once
 * src/config/placeholders.ts is filled in, the sentinels disappear and this
 * renders as plain text with no markup left behind.
 *
 * No wording lives here — the markers are literal sentinels, identical in both
 * locales, and every translatable string stays in the locale trees.
 */
import { TBD, VERIFY } from '../config/placeholders';

interface Props {
  text: string;
}

const { text } = Astro.props;

// Keeping the delimiters in the result is what lets each be styled to say a
// different thing, so the pattern is a capture group.
const parts = text.split(/(\[TBD\]|\[VERIFY\])/g);
---

{
  parts.map((part) =>
    part === TBD ? (
      <span class="tbd">{part}</span>
    ) : part === VERIFY ? (
      <span class="verify">{part}</span>
    ) : (
      <>{part}</>
    )
  )
}
