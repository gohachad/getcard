---
/**
 * What the card actually gets you, in two columns — one per audience.
 *
 * No section heading: the benefits are the heading. Each line carries a green
 * check in --color-success, the same green the hero uses for an upgraded
 * value, so "this is a gain" reads the same way everywhere on the page.
 *
 * Services are named in plain body text because that is what people search
 * for and what they actually want to know is covered. Names only — no logos,
 * no marks, and no suggestion that any of them endorses or is connected to
 * getcard.
 *
 * The two columns are also the two directions of travel, and the
 * --color-signal hairline running down the page's centre axis passes exactly
 * between them. Nothing labels that.
 */
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="benefits section" id="benefits">
  <div class="measure">
    <div class="columns">
      {
        copy.benefits.columns.map((column) => (
          <div class="column">
            <h2>{column.title}</h2>
            <ul>
              {column.items.map((item) => (
                <li>
                  <svg class="check" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path
                      d="M4 10.5l4 4 8-9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  h2 {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    margin: 0 0 24px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: start;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-ink);
  }

  .check {
    color: var(--color-success);
    margin-top: 5px;
  }

  @media (min-width: 768px) {
    .columns {
      /* Two equal tracks, so the gap's midpoint is the page's centre axis —
         where the connecting line runs. */
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .column:first-child {
      padding-right: 40px;
    }

    .column:last-child {
      padding-left: 40px;
      border-left: 1px solid var(--color-hairline);
    }
  }
</style>
