---
import { t, type Locale } from '../i18n';
import CardRender from './CardRender.astro';
import Copy from './Copy.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const { comparison } = copy;
const { highlights } = copy.hero;

// Gold is the baseline and the card most people take, so it is what the page
// opens on. Every other tier is presented as a change from it.
const tiers = comparison.tiers;
const baseline = tiers[0];

// Rows that can differ between tiers, followed by rows that never do. Keeping
// the varying ones first means the upgrade highlights land in one place
// instead of being scattered down the list.
// Our own fee leads: it is the number the visitor is actually deciding about,
// and burying it under the bank's terms made them hunt for it.
//
// Rows every plan has come first, then the ones only the higher plans carry.
// A plan that lacks a benefit does not show the row at all, so keeping the
// variable rows last means the list grows downward as you move up the tiers
// rather than reshuffling.
const perTierRows = [
  'annualFee',
  'dailyLimit',
  'expressIssue',
  'minBalance',
  'lounge',
  'personalManager',
  'limitIncrease',
] as const;

/** Which tiers actually offer this row — the rest never render it. */
const tiersWith = (row: (typeof perTierRows)[number]) =>
  tiers
    .filter((tier) => tier[row] !== '')
    .map((tier) => tier.id)
    .join(' ');
const sharedRows = [
  'dailyTransactions',
  'atmFee',
  'crossCurrency',
  'currencies',
  'wallets',
] as const;
---

<section class="hero section" aria-labelledby="hero-heading" data-tier={baseline.id}>
  <div class="measure hero-head">
    <h1 id="hero-heading">{copy.hero.headline}</h1>

    <p class="tagline">{copy.hero.tagline}</p>

    {/* The argument, then the evidence. Four equal tiles gave the physical
        card the same weight as the conversion rate; it leads now, with room
        for a photograph of the thing itself, and the other claims are reduced
        to the figures they always were. */}
    <div class="highlights">
      <article class="highlight-lead" aria-labelledby="highlight-lead-heading">
        <p class="badge highlight-pill">{highlights.lead.pill}</p>
        <h2 id="highlight-lead-heading">{highlights.lead.title}</h2>
        <p class="highlight-body">{highlights.lead.body}</p>

        {/* The point of the block, so it gets real height rather than a
            thumbnail. Neutral surface until the photograph exists — the same
            habit as the [TBD] markers: show the gap, do not invent a filler.

            To swap in the real photograph:
              import { Image } from 'astro:assets';
              import plastic from '../assets/plastic-card.jpg';
              <Image src={plastic} alt={highlights.lead.mediaAlt} widths={[480, 720, 960]}
                     sizes="(min-width: 1024px) 42vw, 92vw" class="highlight-photo" /> */}
        <figure class="highlight-media">
          <div class="highlight-placeholder" role="img" aria-label={highlights.lead.mediaAlt}></div>
        </figure>
      </article>

      <ul class="stats">
        {
          highlights.stats.map((stat) => (
            <li data-stat={stat.id}>
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-text">
                <strong class="stat-label">{stat.label}</strong>
                <span class="stat-note">
                  <Copy text={stat.note} />
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-actions">
      <a class="pill-filled" href="#tiers">{copy.hero.ctaPrimary}</a>
      <a class="pill-outlined" href="#process">{copy.hero.ctaSecondary}</a>
    </div>

    {/* Issuer disclosure, kept in the section but out of the way: 1998 is in
        the third statistic now, so this no longer repeats it. */}
    <p class="issuer">{copy.hero.issuer}</p>
  </div>

  <div class="card-stage">
    <div class="card-tilt">
      {
        tiers.map((tier) => (
          <div class="card-slot" data-slot={tier.id}>
            <CardRender
              tier={tier.id as 'gold' | 'platinum' | 'infinite'}
              label={`${copy.hero.cardAlt} — ${tier.name}`}
              active={tier.id === baseline.id}
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="measure">
    <div
      class="tier-selector"
      role="radiogroup"
      aria-label={copy.hero.tierSelectorLabel}
      data-tier-selector
    >
      {
        tiers.map((tier) => (
          <button
            type="button"
            role="radio"
            class="tier-option"
            data-tier-option={tier.id}
            aria-checked={tier.id === baseline.id ? 'true' : 'false'}
            tabindex={tier.id === baseline.id ? 0 : -1}
          >
            {tier.name}
          </button>
        ))
      }
    </div>

    {/* Every tier's terms are in the DOM at build time, so without JS the
        baseline plan still renders completely and the section still reads. */}
    <dl class="comparison" aria-label={copy.hero.comparisonLabel}>
      {/* Our fee first — it is the number the visitor is deciding about. All
          three currencies are in the DOM; the switcher only changes which is
          shown, so there is no conversion happening at runtime. */}
      <div class="row row-fee">
        <dt>{comparison.labels.serviceFee}</dt>
        {/* The currency sign is the control: tapping it moves to the next
            currency. It stays in sync with the switch above the plans because
            both only set data-currency on <html>. */}
        <dd class="fee-cell">
          <span class="fee-amounts">
            {
              comparison.currencies.map((currency) => (
                <span class="value value-fee" data-currency={currency.id}>
                  <Copy
                    text={comparison.serviceFeeAmountBy[currency.id as 'rub' | 'usd' | 'eur']}
                  />
                </span>
              ))
            }
          </span>

          <button
            type="button"
            class="currency-toggle"
            aria-label={comparison.currencyToggleLabel}
            title={comparison.currencyToggleLabel}
            data-currency-toggle
          >
            {
              comparison.currencies.map((currency) => (
                <span class="currency-sign" data-currency={currency.id}>
                  {currency.label}
                </span>
              ))
            }
          </button>
        </dd>
      </div>

      {
        perTierRows.map((row) => (
          <div class="row" data-tiers={tiersWith(row)}>
            <dt>{comparison.labels[row]}</dt>
            <dd>
              {tiers.map((tier) => tier[row] !== '' && (
                <span
                  class="value"
                  data-value={tier.id}
                  data-advantage={tier.advantages.includes(row) ? '' : undefined}
                >
                  <Copy text={tier[row]} />
                  {tier.advantages.includes(row) && (
                    <span class="advantage-mark" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14">
                        <path
                          d="M3.5 8.5l3 3 6-7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span class="sr-only">{copy.hero.advantageLabel}</span>
                    </span>
                  )}
                </span>
              ))}
            </dd>
          </div>
        ))
      }

      {
        sharedRows.map((row) => (
          <div class="row">
            <dt>{comparison.labels[row]}</dt>
            <dd>
              <span class="value value-static">
                <Copy text={comparison.shared[row]} />
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // The one animated moment on the page. Selecting a tier flips a single data
  // attribute; the swap is CSS from there. The only thing JS adds beyond that
  // is retriggering the upgrade animation, which CSS cannot do on its own
  // because the animated elements are already in their final state.
  const hero = document.querySelector<HTMLElement>('.hero');
  const group = document.querySelector<HTMLElement>('[data-tier-selector]');

  if (hero && group) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tier-option]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const select = (index: number, moveFocus = false) => {
      const chosen = options[index];
      if (!chosen) return;

      const tier = chosen.dataset.tierOption ?? '';
      const changed = hero.dataset.tier !== tier;
      hero.dataset.tier = tier;

      options.forEach((option, i) => {
        const isChosen = i === index;
        option.setAttribute('aria-checked', String(isChosen));
        option.tabIndex = isChosen ? 0 : -1;
      });

      // Only the visible card should be reachable by assistive tech.
      hero.querySelectorAll<HTMLElement>('.card-slot').forEach((slot) => {
        const svg = slot.querySelector('svg');
        if (!svg) return;
        if (slot.dataset.slot === tier) svg.removeAttribute('aria-hidden');
        else svg.setAttribute('aria-hidden', 'true');
      });

      // Replay the pop on this plan's advantages.
      if (changed && !reduceMotion.matches) {
        hero
          .querySelectorAll<HTMLElement>(`.value[data-value="${tier}"][data-advantage]`)
          .forEach((el) => {
            el.classList.remove('is-upgrading');
            // Reading offsetWidth forces a reflow, which is what lets the same
            // animation run again rather than being treated as unchanged.
            void el.offsetWidth;
            el.classList.add('is-upgrading');
          });
      }

      if (moveFocus) chosen.focus();
    };

    options.forEach((option, index) => {
      option.addEventListener('click', () => select(index));
    });

    // The currency sign next to our fee cycles to the next currency. It only
    // sets the attribute on <html>; the switch above the plans listens for the
    // event and re-syncs its own checked state, so the two controls can never
    // disagree about which currency is showing.
    const ORDER = ['rub', 'usd', 'eur'];
    const toggle = document.querySelector<HTMLButtonElement>('[data-currency-toggle]');

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.dataset.currency ?? ORDER[0];
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      document.documentElement.dataset.currency = next;
      document.dispatchEvent(new CustomEvent('currencychange', { detail: next }));
    });

    group.addEventListener('keydown', (event) => {
      const current = options.findIndex((option) => option.tabIndex === 0);
      if (current < 0) return;

      const step =
        event.key === 'ArrowRight' || event.key === 'ArrowDown'
          ? 1
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
            ? -1
            : 0;

      if (step === 0) return;
      event.preventDefault();
      select((current + step + options.length) % options.length, true);
    });
  }
</script>

<style>
  /* A warm-to-cool wash rather than the flat canvas, with a soft light behind
     where the card sits. It gives the first screen some depth without putting
     a decorative object on it — the card is still the only real image. */
  .hero {
    text-align: center;
    overflow-x: clip;
    background:
      radial-gradient(58rem 30rem at 50% 88%, rgba(0, 113, 227, 0.22), transparent 64%),
      radial-gradient(40rem 24rem at 8% -6%, rgba(201, 163, 92, 0.34), transparent 62%),
      radial-gradient(42rem 24rem at 94% 4%, rgba(41, 151, 255, 0.28), transparent 62%),
      radial-gradient(34rem 20rem at 78% 52%, rgba(60, 63, 102, 0.12), transparent 65%),
      linear-gradient(#ffffff 0%, #f2f6fc 45%, var(--color-canvas) 100%);
  }

  /* Highlights — one lead claim, three supporting figures.
     Single column by default; the asymmetric split only appears once there is
     room for the photograph to be worth showing. */
  .highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 940px;
    margin: 26px auto 0;
    text-align: left;
  }

  /* The lead card is the one loud thing on this screen.

     Four white boxes on a near-white wash gave the page no focal point at all,
     and the product's own material — a gold Visa on a dark face — was sitting
     unused two hundred pixels below. So the lead claim is set as a card face:
     graphite ground, gold hairline, gold eyebrow. The three figures beside it
     stay white and quiet, which is what makes the split read as deliberate
     rather than as two columns that happen to differ in width.

     Both colours are already on this page — the gold is the card render's own,
     the graphite is --color-ink. Nothing new enters the palette. */
  .highlight-lead {
    --gold: #c9a35c;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    background:
      radial-gradient(26rem 15rem at 92% -14%, rgba(201, 163, 92, 0.34), transparent 66%),
      linear-gradient(160deg, #262931 0%, var(--color-ink) 58%, #161719 100%);
    /* Deeper than the stats' lift: this one is meant to sit above the page the
       way the card render does, without borrowing --shadow-xl outright. */
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 18px 40px -24px rgba(29, 29, 31, 0.55);
  }

  .stats li {
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    /* Not --shadow-xl: that one belongs to the card render alone. This is a
       far softer lift, just enough to separate the cards from the wash. */
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  /* A label, not a control. Takes the global .badge shape and recolours it for
     the dark ground — 6.9:1 on this background. */
  .highlight-pill.badge {
    align-self: start;
    margin: 0;
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 55%, transparent);
    background: rgba(201, 163, 92, 0.09);
  }

  .highlight-lead h2 {
    margin: 0;
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--color-white);
  }

  .highlight-body {
    margin: 0;
    max-width: 44ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: #b9bcc3;
  }

  /* The photograph is the argument, so it takes the remaining height rather
     than a fixed one — on tall viewports the card grows into the column
     instead of leaving a gap under it. */
  .highlight-media {
    margin: 2px 0 0;
    flex: 1;
    display: flex;
  }

  .highlight-placeholder {
    width: 100%;
    /* 16:9 at every width. A 4:3 slot on a phone pushed everything below it
       off the first screen, and the card itself is a wide object anyway. */
    min-height: 132px;
    /* Capped, not just proportioned. Left to the aspect ratio alone the slot
       grew with the column and pushed the CTAs off the first screen — which is
       the opposite of what a hero is for. Still a photograph, not a thumbnail. */
    max-height: 150px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    /* Deliberately empty, the same habit as the [TBD] markers: show the gap
       rather than dress it with a stock photo. Cut into the card face rather
       than laid on top, so an unfilled slot reads as part of the design
       instead of a missing image. */
    background:
      radial-gradient(20rem 10rem at 50% 120%, rgba(201, 163, 92, 0.13), transparent 70%),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.018) 0 14px,
        rgba(255, 255, 255, 0.038) 14px 28px
      );
    border: 1px solid rgba(201, 163, 92, 0.18);
    box-shadow: inset 0 1px 14px rgba(0, 0, 0, 0.4);
  }

  /* Three compact rows. The numeral is what makes them scannable, so it keeps
     its own fixed track at every width — it never stacks above the label. */
  .stats {
    display: grid;
    gap: 12px;
    grid-auto-rows: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    /* One gutter for all three rows, in a length that does not depend on any
       row's own font size — `ch` did, so the smaller SWIFT row pulled its
       label 12px left of the other two. */
    --stat-gutter: 72px;
  }

  .stats li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    transition:
      transform 200ms ease-out,
      border-color 200ms ease-out;
  }

  .stats li:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-action) 40%, var(--color-hairline));
  }

  /* The figures are the reason anyone stops on this block, so they are set at
     the heading step in the action blue rather than as bold body text. At 28px
     and ink they read as a spec table; this reads as a claim. */
  .stat-figure {
    flex: none;
    min-width: var(--stat-gutter);
    font-size: var(--text-heading-sm);
    line-height: 1;
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    color: var(--color-action);
    font-variant-numeric: tabular-nums;
  }

  /* SWIFT is a word, not a figure. At the numeral size it takes half the row
     and the gutter it forces would push the other two labels far right, so it
     drops a step and reads as the token it is. */
  [data-stat='transfers'] .stat-figure {
    font-size: var(--text-subheading);
    letter-spacing: 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    /* Without this a long note refuses to wrap and pushes the row wider than
       its column — the 360px failure mode. */
    min-width: 0;
  }

  .stat-label {
    font-size: var(--text-body-sm);
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-ink);
  }

  .stat-note {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--color-ash);
    overflow-wrap: anywhere;
  }

  @media (min-width: 1024px) {
    /* The asymmetric split. The lead card takes the wider track because it is
       carrying a photograph; the figures need only their own width. */
    .highlights {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }

    .highlight-lead {
      padding: 20px;
    }

    .highlight-placeholder {
      min-height: 170px;
      max-height: 190px;
    }

    /* Full size only where there is room for it. The figure carries the row,
       so it gets the heading step rather than the one below it. */
    .stats {
      --stat-gutter: 92px;
    }

    .stat-figure {
      font-size: var(--text-heading);
      letter-spacing: var(--text-heading--letter-spacing);
    }

    [data-stat='transfers'] .stat-figure {
      font-size: var(--text-heading-sm);
    }

    .stat-label {
      font-size: var(--text-body);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats li:hover {
      transform: none;
    }
  }

  @media (max-width: 380px) {
    /* Only the padding gives, never the layout: the horizontal read of
       figure-then-label is the whole point of these rows. */
    .stats li {
      gap: 10px;
      padding: 14px;
    }

    .highlight-lead {
      padding: 16px;
    }
  }

  .hero-head h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 600;
    margin: 0;
  }

  /* One line under the headline, in the whisper weight the system reserves for
     taglines (DESIGN.md §3). */
  .tagline {
    margin: 16px auto 0;
    /* Wide enough that the line does not break mid-phrase on a desktop; it
       still wraps naturally on a phone, where it has to. */
    max-width: 42ch;
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 300;
    color: var(--color-ink);
  }

  /* Now sits under the actions rather than above them, so it reads as fine
     print about the offer instead of a caption on the cards. */
  .issuer {
    margin: 18px auto 0;
    max-width: 46ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-ash);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .card-stage {
    /* The selling points pushed the card off the first screen entirely, which
       cost the page its one real image. Pulled back up so an edge of it shows
       and the visitor knows to keep going. */
    margin-top: 28px;
    padding-inline: 24px;
    display: flex;
    justify-content: center;
  }

  .card-tilt {
    position: relative;
    width: min(820px, 92vw);
    aspect-ratio: 540 / 340;
    rotate: -15deg;
    /* Rotation is not layout, so the corners overhang the element's own box by
       (w·sinθ + h·cosθ − h) / 2 — about 97px at full width. */
    margin-block: clamp(32px, 11vw, 100px);
  }

  .card-slot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease-out;
    pointer-events: none;
  }

  .hero[data-tier='gold'] .card-slot[data-slot='gold'],
  .hero[data-tier='platinum'] .card-slot[data-slot='platinum'],
  .hero[data-tier='infinite'] .card-slot[data-slot='infinite'] {
    opacity: 1;
  }

  .tier-selector {
    display: inline-flex;
    gap: 4px;
    margin-top: 8px;
    padding: 4px;
    background-color: var(--color-pebble);
    border-radius: var(--radius-full);
  }

  .tier-option {
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: 8px 20px;
    font-family: inherit;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-graphite);
    cursor: pointer;
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out;
  }

  .tier-option[aria-checked='true'] {
    background-color: var(--color-action);
    color: var(--color-white);
  }

  /* The comparison itself */
  .comparison {
    margin: 40px auto 0;
    max-width: var(--container-form);
    text-align: left;
    display: grid;
    gap: 0;
  }

  /* A grid rather than a flex row: Russian labels are long enough that a
     wrapping flex row detaches the value onto its own line and strands it.
     Here the label keeps the left track and wraps within it, and the value
     stays on the right whatever happens. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: baseline;
    gap: 4px 16px;
    padding-block: 14px;
    border-top: 1px solid var(--color-hairline);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  /* A plan that does not carry a benefit does not list it. Showing a blank or
     a dash turns the cheapest plan into a column of absences, which argues
     against the card we most want people to take. */
  .hero[data-tier='gold'] .row[data-tiers]:not([data-tiers~='gold']),
  .hero[data-tier='platinum'] .row[data-tiers]:not([data-tiers~='platinum']),
  .hero[data-tier='infinite'] .row[data-tiers]:not([data-tiers~='infinite']) {
    display: none;
  }

  dt {
    font-size: var(--text-body-sm);
    color: var(--color-ash);
  }

  dd {
    margin: 0;
    /* Every tier's value for this row is stacked in the same cell, so the row
       height never jumps as the selection changes. */
    display: grid;
    justify-items: end;
    text-align: right;
  }

  .value {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-body);
    font-weight: 600;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .value-static {
    opacity: 1;
    font-weight: 400;
  }

  .hero[data-tier='gold'] .value[data-value='gold'],
  .hero[data-tier='platinum'] .value[data-value='platinum'],
  .hero[data-tier='infinite'] .value[data-value='infinite'] {
    opacity: 1;
  }

  /* An advantage of the selected plan reads green, with a check — the same
     green as the benefit checks further down the page. Every tier has some,
