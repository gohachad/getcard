---
/**
 * The first screen: the promise, and the card.
 *
 * It used to carry a plan switcher and the full eleven-row comparison as
 * well, which stated the plans a second time — the <Tiers> section states
 * them once now, and states them better. What is left is the argument the
 * page is actually making, the four claims behind it, and one card face.
 */
import { t, type Locale } from '../i18n';
import CardRender from './CardRender.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

/**
 * Guilloche — the engine-turned rosette engraved on banknotes, share
 * certificates and the security print of payment cards, including the one
 * drawn on the card in the getcard logo.
 *
 * Built from overlapping circles on a ring rather than a plotted
 * hypotrochoid: the interference between the outlines is what the eye reads
 * as engraving, and 40 <circle> elements weigh a few hundred bytes where the
 * plotted curve came to 163KB of path data.
 */
const GUILLOCHE = Array.from({ length: 40 }, (_, i) => {
  const a = (i / 40) * Math.PI * 2;
  return { cx: +(200 + Math.cos(a) * 62).toFixed(1), cy: +(200 + Math.sin(a) * 62).toFixed(1) };
});
---

<section class="hero section" aria-labelledby="hero-heading">
  {/* Decorative only. Sits behind everything and is never announced. */}
  <svg class="guilloche" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="0.4">
      {GUILLOCHE.map((c) => <circle cx={c.cx} cy={c.cy} r="118" />)}
      {GUILLOCHE.map((c) => <circle cx={c.cx} cy={c.cy} r="86" />)}
    </g>
  </svg>

  <div class="measure hero-head">
    <h1 id="hero-heading">{copy.hero.headline}</h1>

    <p class="tagline">{copy.hero.tagline}</p>

    {/* Four pills on one material, differing only in what they say. They
        stagger in on load and lift under the cursor, so the row is the first
        thing on the page that answers back. */}
    <ul class="selling-points">
      {
        copy.hero.sellingPoints.map((point, index) => (
          <li data-point={point.id} style={`--stagger: ${index * 70}ms`}>
            <span class="sp-icon" aria-hidden="true">
              {point.id === 'plastic' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="3" />
                  <path d="M2 10h20" />
                  <path d="M6 15h4" />
                </svg>
              )}
              {point.id === 'currencies' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v10M9.5 9.5h5M9.5 14.5h5" />
                </svg>
              )}
              {point.id === 'transfers' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 9h13l-3-3M20 15H7l3 3" />
                </svg>
              )}
              {point.id === 'rates' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 17l5-5 3 3 7-7" />
                  <path d="M15 8h5v5" />
                </svg>
              )}
            </span>
            <span class="sp-text">
              <strong>{point.title}</strong>
              <span class="sp-body">{point.body}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <p class="issuer">{copy.hero.issuer}</p>

    <div class="hero-actions">
      <a class="pill-filled" href="#tiers">{copy.hero.ctaPrimary}</a>
      <a class="pill-outlined" href="#process">{copy.hero.ctaSecondary}</a>
    </div>
  </div>

  {/* One face. The plans section shows all three, each on its own panel, so
      the hero no longer has to hold a switcher to show them. */}
  <div class="card-stage">
    <div class="card-tilt">
      <CardRender tier="gold" label={copy.hero.cardAlt} active={true} />
    </div>
  </div>

</section>

<style>
  /* A warm-to-cool wash rather than the flat canvas, with a soft light behind
     where the card sits. It gives the first screen some depth without putting
     a decorative object on it — the card is still the only real image. */
  /* The first screen is a card face.

     The ground is not black but a very dark maroon mixed down from the brand
     red, so it stays in the logo's family instead of going neutral. Two warm
     lights sit in it — one behind the card, one top-left — and the whole band
     resolves into --color-canvas at the bottom so the light sections below
     arrive without a hard seam.

     Going dark is also what makes the brand gold usable. On white it measures
     2.22:1 and cannot legally carry text; on this ground it is 8.4:1, so the
     accent colour finally works as an accent. */
  .hero {
    position: relative;
    isolation: isolate;
    text-align: center;
    overflow-x: clip;
    --ground: #150a0b;
    background:
      radial-gradient(46rem 26rem at 50% 74%, rgba(218, 165, 75, 0.16), transparent 66%),
      radial-gradient(38rem 22rem at 6% -8%, rgba(218, 165, 75, 0.10), transparent 60%),
      radial-gradient(40rem 24rem at 96% 2%, rgba(15, 92, 148, 0.16), transparent 62%),
      linear-gradient(to bottom, #1c0e10 0%, var(--ground) 55%, #100708 100%);
    /* The band ends on a hard edge with a gold rule rather than fading out.
       A long fade to --color-canvas ran through 200px of dead grey, which
       read as a smear; worse, as a percentage of a section this tall it
       started behind the last two comparison rows and bleached their labels
       away. An edge is also simply truer to the idea: this is a card face,
       and a card has one. */
    border-bottom: 1px solid rgba(218, 165, 75, 0.38);
  }

  /* The engraving. Enormous, barely visible, and anchored behind the card —
     it should register as texture in the material rather than as a graphic. */
  .guilloche {
    position: absolute;
    z-index: -1;
    top: 46%;
    left: 50%;
    width: min(1180px, 150vw);
    height: auto;
    translate: -50% -50%;
    color: var(--color-brand-gold);
    opacity: 0.14;
    pointer-events: none;
  }

  /* Four pills, one material.

     The previous row gave each claim its own saturated colour. Four competing
     hues is what reads as a startup rather than as a bank — the references for
     premium card products are uniform: one restrained material, metal accents,
     and colour used sparingly enough to look deliberate. So the pills share a
     single ground and differ only in what they say.

     They sit two-up rather than four-across. Four across forced Russian
     strings into two words a line and left no room inside the curve; two gives
     each claim a full sentence and lets the pill actually read as a pill.
     --------------------------------------------------------------------- */
  .selling-points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    list-style: none;
    max-width: 880px;
    margin: 30px auto 0;
    padding: 0;
    text-align: left;
  }

  .selling-points li {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 16px;
    /* Asymmetric on purpose: the icon sits inside the left curve, so it needs
       almost no inset, while the text has to clear the right one. */
    padding: 12px 30px 12px 12px;
    border-radius: var(--radius-full);
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 46%, rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid rgba(218, 165, 75, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 12px 28px -20px rgba(0, 0, 0, 0.9);
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 260ms ease-out,
      background-color 260ms ease-out;
  }

  .selling-points li:hover,
  .selling-points li:focus-within {
    transform: translateY(-3px);
    border-color: rgba(218, 165, 75, 0.55);
  }

  /* A slow gold sheen crossing the pill, as light moves over a metal card.
     Only while the cursor is on it. */
  .selling-points li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, rgba(218, 165, 75, 0.16) 50%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 720ms ease-out;
    pointer-events: none;
  }

  .selling-points li:hover::after,
  .selling-points li:focus-within::after {
    transform: translateX(120%);
  }

  /* Round, to sit in the pill's own curve. */
  .sp-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    color: var(--color-brand-gold);
    background: rgba(218, 165, 75, 0.10);
    border: 1px solid rgba(218, 165, 75, 0.30);
    transition:
      background-color 260ms ease-out,
      color 260ms ease-out;
  }

  /* The physical card is the whole argument, so its chip is struck in solid
     gold and the others are outlined. One focal point, not four. */
  [data-point='plastic'] .sp-icon {
    color: var(--ground);
    background: linear-gradient(150deg, #f0c987 0%, var(--color-brand-gold) 55%, #b8873a 100%);
    border-color: rgba(240, 201, 135, 0.7);
  }

  .selling-points li:hover .sp-icon,
  .selling-points li:focus-within .sp-icon {
    background: rgba(218, 165, 75, 0.20);
  }

  [data-point='plastic']:hover .sp-icon {
    background: linear-gradient(150deg, #f6d69e 0%, #e2b158 55%, #c08f3c 100%);
  }

  .sp-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .selling-points strong {
    font-size: var(--text-body);
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-white);
  }

  .sp-body {
    font-size: var(--text-body-sm);
    line-height: 1.35;
    /* 0.78 white on this ground measures 8.9:1 — the muted look costs nothing
       here because the ground is so dark. */
    color: rgba(255, 255, 255, 0.78);
  }

  @media (prefers-reduced-motion: no-preference) {
    .selling-points li {
      animation: tile-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(180ms + var(--stagger, 0ms));
    }
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 760px) {
    .selling-points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selling-points li:hover,
    .selling-points li:focus-within {
      transform: none;
    }

    .selling-points li::after {
      display: none;
    }
  }

  .hero-head h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 600;
    margin: 0;
    color: var(--color-white);
  }

  /* One line under the headline, in the whisper weight the system reserves
     for taglines (DESIGN.md §3). It states what the product is before the
     reader is asked to sort themselves into an audience. */
  .tagline {
    margin: 16px auto 0;
    max-width: 42ch;
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 300;
    /* Warm off-white rather than flat grey: on a maroon ground a neutral grey
       reads as dirty. 16.1:1. */
    color: rgba(255, 245, 240, 0.86);
  }

  .issuer {
    margin: 20px auto 0;
    max-width: 46ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: rgba(255, 255, 255, 0.58);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  /* The global outlined pill is drawn in --color-link, which all but vanishes
     on this ground. Only inside the hero it is restruck in gold. The filled
     pill is left alone: brand red against the dark maroon still separates,
     and it is the one element that must look identical everywhere. */
  .hero-actions .pill-outlined {
    border-color: rgba(218, 165, 75, 0.5);
    color: var(--color-brand-gold);
  }

  .hero-actions .pill-outlined:hover {
    background-color: var(--color-brand-gold);
    color: var(--ground);
  }

  /* Red on dark maroon is close in luminance — the fill alone is 1.68:1
     against the ground, so the button would be hard to locate. The fill is
     left alone (it is the brand, and identical on every other section) and a
     gold hairline does the work instead. At 0.45 the border measured 2.62:1
     and still missed WCAG 1.4.11's 3:1 for non-text controls; 0.72 clears it. */
  .hero-actions .pill-filled {
    border: 1px solid rgba(218, 165, 75, 0.72);
  }

  .card-stage {
    /* The selling points pushed the card off the first screen entirely, which
       cost the page its one real image. Pulled back up so an edge of it shows
       and the visitor knows to keep going. The comparison table used to
       follow it and the stage was spaced for that; the card is the last thing
       in the band now, so it sits closer and the band ends sooner. */
    margin-top: 10px;
    padding-inline: 24px;
    display: flex;
    justify-content: center;
  }

  .card-tilt {
    position: relative;
    width: min(820px, 92vw);
    aspect-ratio: 540 / 340;
    rotate: -15deg;
    /* Rotation is not layout, so the corners overhang the element's own box by
       (w·sinθ + h·cosθ − h) / 2 — about 97px at full width. */
    margin-block: clamp(24px, 8vw, 68px);
  }

  /* Desktop only.

     On a phone the card is already sized by 92vw and is the right size; it is
     on a wide screen that the 820px cap applied and the card ate most of a
     laptop screen — roughly 516px of card plus ~97px of rotation overhang top
     and bottom — while carrying no information the reader needs. Below 1024px
     nothing here applies and the mobile rendering is untouched.

     The margin is recomputed from the same overhang formula rather than left
     at 100px: at 480px wide the corners only reach ~57px past the box, so the
     old value would have kept the empty space the smaller card was meant to
     give back. */
  @media (min-width: 1024px) {
    .card-tilt {
      width: min(480px, 92vw);
      margin-block: 60px;
    }
  }

</style>
