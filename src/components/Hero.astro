---
import { t, type Locale } from '../i18n';
import CardRender from './CardRender.astro';
import Copy from './Copy.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const { comparison } = copy;

// Gold is the baseline and the card most people take, so it is what the page
// opens on. Every other tier is presented as a change from it.
const tiers = comparison.tiers;
const baseline = tiers[0];

// Rows that can differ between tiers, followed by rows that never do. Keeping
// the varying ones first means the upgrade highlights land in one place
// instead of being scattered down the list.
// Our own fee leads: it is the number the visitor is actually deciding about,
// and burying it under the bank's terms made them hunt for it.
//
// Rows every plan has come first, then the ones only the higher plans carry.
// A plan that lacks a benefit does not show the row at all, so keeping the
// variable rows last means the list grows downward as you move up the tiers
// rather than reshuffling.
const perTierRows = [
  'annualFee',
  'dailyLimit',
  'expressIssue',
  'minBalance',
  'lounge',
  'personalManager',
  'limitIncrease',
] as const;

/** Which tiers actually offer this row — the rest never render it. */
const tiersWith = (row: (typeof perTierRows)[number]) =>
  tiers
    .filter((tier) => tier[row] !== '')
    .map((tier) => tier.id)
    .join(' ');
const sharedRows = [
  'dailyTransactions',
  'atmFee',
  'crossCurrency',
  'currencies',
  'wallets',
] as const;
---

<section class="hero section" aria-labelledby="hero-heading" data-tier={baseline.id}>
  <div class="measure hero-head">
    <h1 id="hero-heading">{copy.hero.headline}</h1>

    <ul class="audiences">
      {
        copy.hero.audiences.map((audience) => (
          <li>
            <span class="audience-label">{audience.label}</span>
            <span class="audience-slogan">{audience.slogan}</span>
          </li>
        ))
      }
    </ul>

    {/* The four reasons to keep reading, before the fold. Each tile takes its
        accent from something already in the system — the card's own gold, the
        action blue, the success green, the Infinite card's indigo — so the row
        reads as colourful without introducing a new palette. */}
    <ul class="selling-points">
      {
        copy.hero.sellingPoints.map((point) => (
          <li data-point={point.id}>
            <span class="sp-icon" aria-hidden="true">
              {point.id === 'plastic' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="3" />
                  <path d="M2 10h20" />
                  <path d="M6 15h4" />
                </svg>
              )}
              {point.id === 'currencies' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v10M9.5 9.5h5M9.5 14.5h5" />
                </svg>
              )}
              {point.id === 'transfers' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 9h13l-3-3M20 15H7l3 3" />
                </svg>
              )}
              {point.id === 'rates' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 17l5-5 3 3 7-7" />
                  <path d="M15 8h5v5" />
                </svg>
              )}
            </span>
            <strong>{point.title}</strong>
            <span class="sp-body">{point.body}</span>
          </li>
        ))
      }
    </ul>

    <p class="issuer">{copy.hero.issuer}</p>

    <div class="hero-actions">
      <a class="pill-filled" href="#tiers">{copy.hero.ctaPrimary}</a>
      <a class="pill-outlined" href="#process">{copy.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="card-stage">
    <div class="card-tilt">
      {
        tiers.map((tier) => (
          <div class="card-slot" data-slot={tier.id}>
            <CardRender
              tier={tier.id as 'gold' | 'platinum' | 'infinite'}
              label={`${copy.hero.cardAlt} — ${tier.name}`}
              active={tier.id === baseline.id}
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="measure">
    <div
      class="tier-selector"
      role="radiogroup"
      aria-label={copy.hero.tierSelectorLabel}
      data-tier-selector
    >
      {
        tiers.map((tier) => (
          <button
            type="button"
            role="radio"
            class="tier-option"
            data-tier-option={tier.id}
            aria-checked={tier.id === baseline.id ? 'true' : 'false'}
            tabindex={tier.id === baseline.id ? 0 : -1}
          >
            {tier.name}
          </button>
        ))
      }
    </div>

    {/* Every tier's terms are in the DOM at build time, so without JS the
        baseline plan still renders completely and the section still reads. */}
    <dl class="comparison" aria-label={copy.hero.comparisonLabel}>
      {/* Our fee first — it is the number the visitor is deciding about. All
          three currencies are in the DOM; the switcher only changes which is
          shown, so there is no conversion happening at runtime. */}
      <div class="row row-fee">
        <dt>{comparison.labels.serviceFee}</dt>
        {/* The currency sign is the control: tapping it moves to the next
            currency. It stays in sync with the switch above the plans because
            both only set data-currency on <html>. */}
        <dd class="fee-cell">
          <span class="fee-amounts">
            {
              comparison.currencies.map((currency) => (
                <span class="value value-fee" data-currency={currency.id}>
                  <Copy
                    text={comparison.serviceFeeAmountBy[currency.id as 'rub' | 'usd' | 'eur']}
                  />
                </span>
              ))
            }
          </span>

          <button
            type="button"
            class="currency-toggle"
            aria-label={comparison.currencyToggleLabel}
            title={comparison.currencyToggleLabel}
            data-currency-toggle
          >
            {
              comparison.currencies.map((currency) => (
                <span class="currency-sign" data-currency={currency.id}>
                  {currency.label}
                </span>
              ))
            }
          </button>
        </dd>
      </div>

      {
        perTierRows.map((row) => (
          <div class="row" data-tiers={tiersWith(row)}>
            <dt>{comparison.labels[row]}</dt>
            <dd>
              {tiers.map((tier) => tier[row] !== '' && (
                <span
                  class="value"
                  data-value={tier.id}
                  data-advantage={tier.advantages.includes(row) ? '' : undefined}
                >
                  <Copy text={tier[row]} />
                  {tier.advantages.includes(row) && (
                    <span class="advantage-mark" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14">
                        <path
                          d="M3.5 8.5l3 3 6-7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span class="sr-only">{copy.hero.advantageLabel}</span>
                    </span>
                  )}
                </span>
              ))}
            </dd>
          </div>
        ))
      }

      {
        sharedRows.map((row) => (
          <div class="row">
            <dt>{comparison.labels[row]}</dt>
            <dd>
              <span class="value value-static">
                <Copy text={comparison.shared[row]} />
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // The one animated moment on the page. Selecting a tier flips a single data
  // attribute; the swap is CSS from there. The only thing JS adds beyond that
  // is retriggering the upgrade animation, which CSS cannot do on its own
  // because the animated elements are already in their final state.
  const hero = document.querySelector<HTMLElement>('.hero');
  const group = document.querySelector<HTMLElement>('[data-tier-selector]');

  if (hero && group) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tier-option]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const select = (index: number, moveFocus = false) => {
      const chosen = options[index];
      if (!chosen) return;

      const tier = chosen.dataset.tierOption ?? '';
      const changed = hero.dataset.tier !== tier;
      hero.dataset.tier = tier;

      options.forEach((option, i) => {
        const isChosen = i === index;
        option.setAttribute('aria-checked', String(isChosen));
        option.tabIndex = isChosen ? 0 : -1;
      });

      // Only the visible card should be reachable by assistive tech.
      hero.querySelectorAll<HTMLElement>('.card-slot').forEach((slot) => {
        const svg = slot.querySelector('svg');
        if (!svg) return;
        if (slot.dataset.slot === tier) svg.removeAttribute('aria-hidden');
        else svg.setAttribute('aria-hidden', 'true');
      });

      // Replay the pop on this plan's advantages.
      if (changed && !reduceMotion.matches) {
        hero
          .querySelectorAll<HTMLElement>(`.value[data-value="${tier}"][data-advantage]`)
          .forEach((el) => {
            el.classList.remove('is-upgrading');
            // Reading offsetWidth forces a reflow, which is what lets the same
            // animation run again rather than being treated as unchanged.
            void el.offsetWidth;
            el.classList.add('is-upgrading');
          });
      }

      if (moveFocus) chosen.focus();
    };

    options.forEach((option, index) => {
      option.addEventListener('click', () => select(index));
    });

    // The currency sign next to our fee cycles to the next currency. It only
    // sets the attribute on <html>; the switch above the plans listens for the
    // event and re-syncs its own checked state, so the two controls can never
    // disagree about which currency is showing.
    const ORDER = ['rub', 'usd', 'eur'];
    const toggle = document.querySelector<HTMLButtonElement>('[data-currency-toggle]');

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.dataset.currency ?? ORDER[0];
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      document.documentElement.dataset.currency = next;
      document.dispatchEvent(new CustomEvent('currencychange', { detail: next }));
    });

    group.addEventListener('keydown', (event) => {
      const current = options.findIndex((option) => option.tabIndex === 0);
      if (current < 0) return;

      const step =
        event.key === 'ArrowRight' || event.key === 'ArrowDown'
          ? 1
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
            ? -1
            : 0;

      if (step === 0) return;
      event.preventDefault();
      select((current + step + options.length) % options.length, true);
    });
  }
</script>

<style>
  /* A warm-to-cool wash rather than the flat canvas, with a soft light behind
     where the card sits. It gives the first screen some depth without putting
     a decorative object on it — the card is still the only real image. */
  .hero {
    text-align: center;
    overflow-x: clip;
    background:
      radial-gradient(58rem 30rem at 50% 88%, rgba(0, 113, 227, 0.22), transparent 64%),
      radial-gradient(40rem 24rem at 8% -6%, rgba(201, 163, 92, 0.34), transparent 62%),
      radial-gradient(42rem 24rem at 94% 4%, rgba(41, 151, 255, 0.28), transparent 62%),
      radial-gradient(34rem 20rem at 78% 52%, rgba(60, 63, 102, 0.12), transparent 65%),
      linear-gradient(#ffffff 0%, #f2f6fc 45%, var(--color-canvas) 100%);
  }

  /* Selling points */
  .selling-points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    list-style: none;
    max-width: 940px;
    margin: 26px auto 0;
    padding: 0;
    text-align: left;
  }

  .selling-points li {
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-areas: 'icon title' 'icon body';
    align-items: center;
    gap: 0 12px;
    padding: 14px 16px;
    background: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    /* Not --shadow-xl: that one belongs to the card render alone. This is a
       far softer lift, just enough to separate the tiles from the wash. */
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition:
      transform 200ms ease-out,
      border-color 200ms ease-out;
  }

  .selling-points li:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--color-hairline));
  }

  .sp-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-card);
    color: var(--accent);
    background: var(--accent-wash);
  }

  .selling-points strong {
    grid-area: title;
    font-size: var(--text-body);
    line-height: 1.3;
    font-weight: 600;
  }

  .sp-body {
    grid-area: body;
    font-size: var(--text-body-sm);
    line-height: 1.35;
    color: var(--color-ash);
  }

  /* One accent per tile, each borrowed from something already in the system:
     the card's gold, the action blue, the success green, Infinite's indigo. */
  [data-point='plastic'] {
    --accent: #8a6a2f;
    --accent-wash: #fdf6e6;
  }
  [data-point='currencies'] {
    --accent: var(--color-action);
    --accent-wash: #eaf3fe;
  }
  [data-point='transfers'] {
    --accent: var(--color-success);
    --accent-wash: var(--color-success-bg);
  }
  [data-point='rates'] {
    --accent: #3c3f66;
    --accent-wash: #eeeff7;
  }

  @media (min-width: 700px) {
    .selling-points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .selling-points {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    /* Four across is tight, so the icon moves above the text rather than
       squeezing the Russian strings into two words per line. */
    .selling-points li {
      grid-template-columns: 1fr;
      grid-template-areas: 'icon' 'title' 'body';
      align-items: start;
      gap: 10px 0;
      padding: 18px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selling-points li:hover {
      transform: none;
    }
  }

  .hero-head h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 600;
    margin: 0;
  }

  /* The two audiences, directly under the headline: each one qualifies the
     promise for a different reader. */
  .audiences {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .audiences li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 8px;
  }

  .audience-label {
    font-size: var(--text-body-sm);
    color: var(--color-ash);
  }

  .audience-slogan {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 300;
    color: var(--color-ink);
  }

  .issuer {
    margin: 14px auto 0;
    max-width: 46ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-ash);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .card-stage {
    /* The selling points pushed the card off the first screen entirely, which
       cost the page its one real image. Pulled back up so an edge of it shows
       and the visitor knows to keep going. */
    margin-top: 28px;
    padding-inline: 24px;
    display: flex;
    justify-content: center;
  }

  .card-tilt {
    position: relative;
    width: min(820px, 92vw);
    aspect-ratio: 540 / 340;
    rotate: -15deg;
    /* Rotation is not layout, so the corners overhang the element's own box by
       (w·sinθ + h·cosθ − h) / 2 — about 97px at full width. */
    margin-block: clamp(32px, 11vw, 100px);
  }

  .card-slot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease-out;
    pointer-events: none;
  }

  .hero[data-tier='gold'] .card-slot[data-slot='gold'],
  .hero[data-tier='platinum'] .card-slot[data-slot='platinum'],
  .hero[data-tier='infinite'] .card-slot[data-slot='infinite'] {
    opacity: 1;
  }

  .tier-selector {
    display: inline-flex;
    gap: 4px;
    margin-top: 8px;
    padding: 4px;
    background-color: var(--color-pebble);
    border-radius: var(--radius-full);
  }

  .tier-option {
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: 8px 20px;
    font-family: inherit;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-graphite);
    cursor: pointer;
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out;
  }

  .tier-option[aria-checked='true'] {
    background-color: var(--color-action);
    color: var(--color-white);
  }

  /* The comparison itself */
  .comparison {
    margin: 40px auto 0;
    max-width: var(--container-form);
    text-align: left;
    display: grid;
    gap: 0;
  }

  /* A grid rather than a flex row: Russian labels are long enough that a
     wrapping flex row detaches the value onto its own line and strands it.
     Here the label keeps the left track and wraps within it, and the value
     stays on the right whatever happens. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: baseline;
    gap: 4px 16px;
    padding-block: 14px;
    border-top: 1px solid var(--color-hairline);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  /* A plan that does not carry a benefit does not list it. Showing a blank or
     a dash turns the cheapest plan into a column of absences, which argues
     against the card we most want people to take. */
  .hero[data-tier='gold'] .row[data-tiers]:not([data-tiers~='gold']),
  .hero[data-tier='platinum'] .row[data-tiers]:not([data-tiers~='platinum']),
  .hero[data-tier='infinite'] .row[data-tiers]:not([data-tiers~='infinite']) {
    display: none;
  }

  dt {
    font-size: var(--text-body-sm);
    color: var(--color-ash);
  }

  dd {
    margin: 0;
    /* Every tier's value for this row is stacked in the same cell, so the row
       height never jumps as the selection changes. */
    display: grid;
    justify-items: end;
    text-align: right;
  }

  .value {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-body);
    font-weight: 600;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .value-static {
    opacity: 1;
    font-weight: 400;
  }

  .hero[data-tier='gold'] .value[data-value='gold'],
  .hero[data-tier='platinum'] .value[data-value='platinum'],
  .hero[data-tier='infinite'] .value[data-value='infinite'] {
    opacity: 1;
  }

  /* An advantage of the selected plan reads green, with a check — the same
     green as the benefit checks further down the page. Every tier has some,
     including Gold: it is the cheapest to keep and locks up no balance. */
  .value[data-advantage] {
    color: var(--color-success);
  }

  .advantage-mark {
    display: inline-flex;
    color: var(--color-success);
  }

  /* Our own fee is the decision, so it is set larger than the bank's terms. */
  .fee-cell {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
  }

  .fee-amounts {
    display: grid;
    justify-items: end;
  }

  .row-fee .value {
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
  }

  .value-fee {
    grid-area: 1 / 1;
    opacity: 0;
  }

  :global([data-currency='rub']) .value-fee[data-currency='rub'],
  :global([data-currency='usd']) .value-fee[data-currency='usd'],
  :global([data-currency='eur']) .value-fee[data-currency='eur'] {
    opacity: 1;
  }

  /* The sign reads as the number's unit but behaves as a control: underlined
     on hover, focusable, and large enough to tap. */
  .currency-toggle {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    background: var(--color-white);
    font-family: inherit;
    font-size: var(--text-heading-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--color-link);
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .currency-toggle:hover {
    background-color: var(--color-link);
    color: var(--color-white);
  }

  .currency-sign {
    grid-area: 1 / 1;
    display: none;
  }

  :global([data-currency='rub']) .currency-sign[data-currency='rub'],
  :global([data-currency='usd']) .currency-sign[data-currency='usd'],
  :global([data-currency='eur']) .currency-sign[data-currency='eur'] {
    display: block;
  }

  .value.is-upgrading {
    animation: upgrade-pop 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes upgrade-pop {
    0% {
      transform: translateY(6px) scale(0.94);
    }
    60% {
      transform: translateY(0) scale(1.06);
    }
    100% {
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 768px) {
    .comparison {
      grid-template-columns: 1fr 1fr;
      column-gap: 48px;
    }

    /* Both columns start their own rule, so the two halves read as one table
       rather than one list wrapped in half. */
    .row:nth-child(2) {
      border-top: 1px solid var(--color-hairline);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-slot,
    .value,
    .tier-option {
      transition: none;
    }

    .value.is-upgrading {
      animation: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
