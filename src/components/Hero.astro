---
import { t, type Locale } from '../i18n';
import CardRender from './CardRender.astro';
import Copy from './Copy.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const { comparison } = copy;

// Gold is the baseline and the card most people take, so it is what the page
// opens on. Every other tier is presented as a change from it.
const tiers = comparison.tiers;
const baseline = tiers[0];

// Rows that can differ between tiers, followed by rows that never do. Keeping
// the varying ones first means the upgrade highlights land in one place
// instead of being scattered down the list.
// Our own fee leads: it is the number the visitor is actually deciding about,
// and burying it under the bank's terms made them hunt for it.
//
// Rows every plan has come first, then the ones only the higher plans carry.
// A plan that lacks a benefit does not show the row at all, so keeping the
// variable rows last means the list grows downward as you move up the tiers
// rather than reshuffling.
const perTierRows = [
  'annualFee',
  'dailyLimit',
  'expressIssue',
  'minBalance',
  'lounge',
  'personalManager',
  'limitIncrease',
] as const;

/** Which tiers actually offer this row — the rest never render it. */
const tiersWith = (row: (typeof perTierRows)[number]) =>
  tiers
    .filter((tier) => tier[row] !== '')
    .map((tier) => tier.id)
    .join(' ');
/**
 * Guilloche — the engine-turned rosette engraved on banknotes, share
 * certificates and the security print of payment cards, including the one
 * drawn on the card in the getcard logo.
 *
 * Built from overlapping circles on a ring rather than a plotted
 * hypotrochoid: the interference between the outlines is what the eye reads
 * as engraving, and 40 <circle> elements weigh a few hundred bytes where the
 * plotted curve came to 163KB of path data.
 */
const GUILLOCHE = Array.from({ length: 40 }, (_, i) => {
  const a = (i / 40) * Math.PI * 2;
  return { cx: +(200 + Math.cos(a) * 62).toFixed(1), cy: +(200 + Math.sin(a) * 62).toFixed(1) };
});

const sharedRows = [
  'dailyTransactions',
  'atmFee',
  'crossCurrency',
  'currencies',
  'wallets',
] as const;
---

<section class="hero section" aria-labelledby="hero-heading" data-tier={baseline.id}>
  {/* Decorative only. Sits behind everything and is never announced. */}
  <svg class="guilloche" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="0.4">
      {GUILLOCHE.map((c) => <circle cx={c.cx} cy={c.cy} r="118" />)}
      {GUILLOCHE.map((c) => <circle cx={c.cx} cy={c.cy} r="86" />)}
    </g>
  </svg>

  <div class="measure hero-head">
    <h1 id="hero-heading">{copy.hero.headline}</h1>

    <p class="tagline">{copy.hero.tagline}</p>

    {/* Four colour fields, not four white boxes.

        Each one carries a colour already in the system — the card render's own
        gold, the action blue, the success green, the Infinite card's indigo —
        but at full saturation rather than as a pastel wash behind an icon. A
        row of white cards with tinted squares reads as a spec table however
        the copy is written; this reads as four claims. They stagger in on load
        and lift under the cursor, so the row is the first thing on the page
        that answers back. */}
    <ul class="selling-points">
      {
        copy.hero.sellingPoints.map((point, index) => (
          <li data-point={point.id} style={`--stagger: ${index * 70}ms`}>
            <span class="sp-icon" aria-hidden="true">
              {point.id === 'plastic' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="3" />
                  <path d="M2 10h20" />
                  <path d="M6 15h4" />
                </svg>
              )}
              {point.id === 'currencies' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v10M9.5 9.5h5M9.5 14.5h5" />
                </svg>
              )}
              {point.id === 'transfers' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 9h13l-3-3M20 15H7l3 3" />
                </svg>
              )}
              {point.id === 'rates' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 17l5-5 3 3 7-7" />
                  <path d="M15 8h5v5" />
                </svg>
              )}
            </span>
            <span class="sp-text">
              <strong>{point.title}</strong>
              <span class="sp-body">{point.body}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <p class="issuer">{copy.hero.issuer}</p>

    <div class="hero-actions">
      <a class="pill-filled" href="#tiers">{copy.hero.ctaPrimary}</a>
      <a class="pill-outlined" href="#process">{copy.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="card-stage">
    <div class="card-tilt">
      {
        tiers.map((tier) => (
          <div class="card-slot" data-slot={tier.id}>
            <CardRender
              tier={tier.id as 'gold' | 'platinum' | 'infinite'}
              label={`${copy.hero.cardAlt} — ${tier.name}`}
              active={tier.id === baseline.id}
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="measure">
    <div
      class="tier-selector"
      role="radiogroup"
      aria-label={copy.hero.tierSelectorLabel}
      data-tier-selector
    >
      {
        tiers.map((tier) => (
          <button
            type="button"
            role="radio"
            class="tier-option"
            data-tier-option={tier.id}
            aria-checked={tier.id === baseline.id ? 'true' : 'false'}
            tabindex={tier.id === baseline.id ? 0 : -1}
          >
            {tier.name}
          </button>
        ))
      }
    </div>

    {/* Every tier's terms are in the DOM at build time, so without JS the
        baseline plan still renders completely and the section still reads. */}
    <dl class="comparison" aria-label={copy.hero.comparisonLabel}>
      {/* Our fee first — it is the number the visitor is deciding about. All
          three currencies are in the DOM; the switcher only changes which is
          shown, so there is no conversion happening at runtime. */}
      <div class="row row-fee">
        <dt>{comparison.labels.serviceFee}</dt>
        {/* The currency sign is the control: tapping it moves to the next
            currency. It stays in sync with the switch above the plans because
            both only set data-currency on <html>. */}
        <dd class="fee-cell">
          <span class="fee-amounts">
            {
              comparison.currencies.map((currency) => (
                <span class="value value-fee" data-currency={currency.id}>
                  <Copy
                    text={comparison.serviceFeeAmountBy[currency.id as 'rub' | 'usd' | 'eur']}
                  />
                </span>
              ))
            }
          </span>

          <button
            type="button"
            class="currency-toggle"
            aria-label={comparison.currencyToggleLabel}
            title={comparison.currencyToggleLabel}
            data-currency-toggle
          >
            {
              comparison.currencies.map((currency) => (
                <span class="currency-sign" data-currency={currency.id}>
                  {currency.label}
                </span>
              ))
            }
          </button>
        </dd>
      </div>

      {
        perTierRows.map((row) => (
          <div class="row" data-tiers={tiersWith(row)}>
            <dt>{comparison.labels[row]}</dt>
            <dd>
              {tiers.map((tier) => tier[row] !== '' && (
                <span
                  class="value"
                  data-value={tier.id}
                  data-advantage={tier.advantages.includes(row) ? '' : undefined}
                >
                  <Copy text={tier[row]} />
                  {tier.advantages.includes(row) && (
                    <span class="advantage-mark" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14">
                        <path
                          d="M3.5 8.5l3 3 6-7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span class="sr-only">{copy.hero.advantageLabel}</span>
                    </span>
                  )}
                </span>
              ))}
            </dd>
          </div>
        ))
      }

      {
        sharedRows.map((row) => (
          <div class="row">
            <dt>{comparison.labels[row]}</dt>
            <dd>
              <span class="value value-static">
                <Copy text={comparison.shared[row]} />
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // The one animated moment on the page. Selecting a tier flips a single data
  // attribute; the swap is CSS from there. The only thing JS adds beyond that
  // is retriggering the upgrade animation, which CSS cannot do on its own
  // because the animated elements are already in their final state.
  const hero = document.querySelector<HTMLElement>('.hero');
  const group = document.querySelector<HTMLElement>('[data-tier-selector]');

  if (hero && group) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tier-option]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const select = (index: number, moveFocus = false) => {
      const chosen = options[index];
      if (!chosen) return;

      const tier = chosen.dataset.tierOption ?? '';
      const changed = hero.dataset.tier !== tier;
      hero.dataset.tier = tier;

      options.forEach((option, i) => {
        const isChosen = i === index;
        option.setAttribute('aria-checked', String(isChosen));
        option.tabIndex = isChosen ? 0 : -1;
      });

      // Only the visible card should be reachable by assistive tech.
      hero.querySelectorAll<HTMLElement>('.card-slot').forEach((slot) => {
        const svg = slot.querySelector('svg');
        if (!svg) return;
        if (slot.dataset.slot === tier) svg.removeAttribute('aria-hidden');
        else svg.setAttribute('aria-hidden', 'true');
      });

      // Replay the pop on this plan's advantages.
      if (changed && !reduceMotion.matches) {
        hero
          .querySelectorAll<HTMLElement>(`.value[data-value="${tier}"][data-advantage]`)
          .forEach((el) => {
            el.classList.remove('is-upgrading');
            // Reading offsetWidth forces a reflow, which is what lets the same
            // animation run again rather than being treated as unchanged.
            void el.offsetWidth;
            el.classList.add('is-upgrading');
          });
      }

      if (moveFocus) chosen.focus();
    };

    options.forEach((option, index) => {
      option.addEventListener('click', () => select(index));
    });

    // The currency sign next to our fee cycles to the next currency. It only
    // sets the attribute on <html>; the switch above the plans listens for the
    // event and re-syncs its own checked state, so the two controls can never
    // disagree about which currency is showing.
    const ORDER = ['rub', 'usd', 'eur'];
    const toggle = document.querySelector<HTMLButtonElement>('[data-currency-toggle]');

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.dataset.currency ?? ORDER[0];
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      document.documentElement.dataset.currency = next;
      document.dispatchEvent(new CustomEvent('currencychange', { detail: next }));
    });

    group.addEventListener('keydown', (event) => {
      const current = options.findIndex((option) => option.tabIndex === 0);
      if (current < 0) return;

      const step =
        event.key === 'ArrowRight' || event.key === 'ArrowDown'
          ? 1
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
            ? -1
            : 0;

      if (step === 0) return;
      event.preventDefault();
      select((current + step + options.length) % options.length, true);
    });
  }
</script>

<style>
  /* A warm-to-cool wash rather than the flat canvas, with a soft light behind
     where the card sits. It gives the first screen some depth without putting
     a decorative object on it — the card is still the only real image. */
  /* The first screen is a card face.

     The ground is not black but a very dark maroon mixed down from the brand
     red, so it stays in the logo's family instead of going neutral. Two warm
     lights sit in it — one behind the card, one top-left — and the whole band
     resolves into --color-canvas at the bottom so the light sections below
     arrive without a hard seam.

     Going dark is also what makes the brand gold usable. On white it measures
     2.22:1 and cannot legally carry text; on this ground it is 8.4:1, so the
     accent colour finally works as an accent. */
  .hero {
    position: relative;
    isolation: isolate;
    text-align: center;
    overflow-x: clip;
    --ground: #150a0b;
    background:
      radial-gradient(46rem 26rem at 50% 74%, rgba(218, 165, 75, 0.16), transparent 66%),
      radial-gradient(38rem 22rem at 6% -8%, rgba(218, 165, 75, 0.10), transparent 60%),
      radial-gradient(40rem 24rem at 96% 2%, rgba(15, 92, 148, 0.16), transparent 62%),
      linear-gradient(to bottom, #1c0e10 0%, var(--ground) 55%, #100708 100%);
    /* The band ends on a hard edge with a gold rule rather than fading out.
       A long fade to --color-canvas ran through 200px of dead grey, which
       read as a smear; worse, as a percentage of a section this tall it
       started behind the last two comparison rows and bleached their labels
       away. An edge is also simply truer to the idea: this is a card face,
       and a card has one. */
    border-bottom: 1px solid rgba(218, 165, 75, 0.38);
  }

  /* The engraving. Enormous, barely visible, and anchored behind the card —
     it should register as texture in the material rather than as a graphic. */
  .guilloche {
    position: absolute;
    z-index: -1;
    top: 46%;
    left: 50%;
    width: min(1180px, 150vw);
    height: auto;
    translate: -50% -50%;
    color: var(--color-brand-gold);
    opacity: 0.14;
    pointer-events: none;
  }

  /* Four pills, one material.

     The previous row gave each claim its own saturated colour. Four competing
     hues is what reads as a startup rather than as a bank — the references for
     premium card products are uniform: one restrained material, metal accents,
     and colour used sparingly enough to look deliberate. So the pills share a
     single ground and differ only in what they say.

     They sit two-up rather than four-across. Four across forced Russian
     strings into two words a line and left no room inside the curve; two gives
     each claim a full sentence and lets the pill actually read as a pill.
     --------------------------------------------------------------------- */
  .selling-points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    list-style: none;
    max-width: 880px;
    margin: 30px auto 0;
    padding: 0;
    text-align: left;
  }

  .selling-points li {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 16px;
    /* Asymmetric on purpose: the icon sits inside the left curve, so it needs
       almost no inset, while the text has to clear the right one. */
    padding: 12px 30px 12px 12px;
    border-radius: var(--radius-full);
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 46%, rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid rgba(218, 165, 75, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 12px 28px -20px rgba(0, 0, 0, 0.9);
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 260ms ease-out,
      background-color 260ms ease-out;
  }

  .selling-points li:hover,
  .selling-points li:focus-within {
    transform: translateY(-3px);
    border-color: rgba(218, 165, 75, 0.55);
  }

  /* A slow gold sheen crossing the pill, as light moves over a metal card.
     Only while the cursor is on it. */
  .selling-points li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, rgba(218, 165, 75, 0.16) 50%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 720ms ease-out;
    pointer-events: none;
  }

  .selling-points li:hover::after,
  .selling-points li:focus-within::after {
    transform: translateX(120%);
  }

  /* Round, to sit in the pill's own curve. */
  .sp-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    color: var(--color-brand-gold);
    background: rgba(218, 165, 75, 0.10);
    border: 1px solid rgba(218, 165, 75, 0.30);
    transition:
      background-color 260ms ease-out,
      color 260ms ease-out;
  }

  /* The physical card is the whole argument, so its chip is struck in solid
     gold and the others are outlined. One focal point, not four. */
  [data-point='plastic'] .sp-icon {
    color: var(--ground);
    background: linear-gradient(150deg, #f0c987 0%, var(--color-brand-gold) 55%, #b8873a 100%);
    border-color: rgba(240, 201, 135, 0.7);
  }

  .selling-points li:hover .sp-icon,
  .selling-points li:focus-within .sp-icon {
    background: rgba(218, 165, 75, 0.20);
  }

  [data-point='plastic']:hover .sp-icon {
    background: linear-gradient(150deg, #f6d69e 0%, #e2b158 55%, #c08f3c 100%);
  }

  .sp-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .selling-points strong {
    font-size: var(--text-body);
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-white);
  }

  .sp-body {
    font-size: var(--text-body-sm);
    line-height: 1.35;
    /* 0.78 white on this ground measures 8.9:1 — the muted look costs nothing
       here because the ground is so dark. */
    color: rgba(255, 255, 255, 0.78);
  }

  @media (prefers-reduced-motion: no-preference) {
    .selling-points li {
      animation: tile-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(180ms + var(--stagger, 0ms));
    }
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 760px) {
    .selling-points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selling-points li:hover,
    .selling-points li:focus-within {
      transform: none;
    }

    .selling-points li::after {
      display: none;
    }
  }

  .hero-head h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 600;
    margin: 0;
    color: var(--color-white);
  }

  /* One line under the headline, in the whisper weight the system reserves
     for taglines (DESIGN.md §3). It states what the product is before the
     reader is asked to sort themselves into an audience. */
  .tagline {
    margin: 16px auto 0;
    max-width: 42ch;
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 300;
    /* Warm off-white rather than flat grey: on a maroon ground a neutral grey
       reads as dirty. 16.1:1. */
    color: rgba(255, 245, 240, 0.86);
  }

  .issuer {
    margin: 20px auto 0;
    max-width: 46ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: rgba(255, 255, 255, 0.58);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  /* The global outlined pill is drawn in --color-link, which all but vanishes
     on this ground. Only inside the hero it is restruck in gold. The filled
     pill is left alone: brand red against the dark maroon still separates,
     and it is the one element that must look identical everywhere. */
  .hero-actions .pill-outlined {
    border-color: rgba(218, 165, 75, 0.5);
    color: var(--color-brand-gold);
  }

  .hero-actions .pill-outlined:hover {
    background-color: var(--color-brand-gold);
    color: var(--ground);
  }

  /* Red on dark maroon is close in luminance — the fill alone is 1.68:1
     against the ground, so the button would be hard to locate. The fill is
     left alone (it is the brand, and identical on every other section) and a
     gold hairline does the work instead. At 0.45 the border measured 2.62:1
     and still missed WCAG 1.4.11's 3:1 for non-text controls; 0.72 clears it. */
  .hero-actions .pill-filled {
    border: 1px solid rgba(218, 165, 75, 0.72);
  }

  .card-stage {
    /* The selling points pushed the card off the first screen entirely, which
       cost the page its one real image. Pulled back up so an edge of it shows
       and the visitor knows to keep going. */
    margin-top: 28px;
    padding-inline: 24px;
    display: flex;
    justify-content: center;
  }

  .card-tilt {
    position: relative;
    width: min(820px, 92vw);
    aspect-ratio: 540 / 340;
    rotate: -15deg;
    /* Rotation is not layout, so the corners overhang the element's own box by
       (w·sinθ + h·cosθ − h) / 2 — about 97px at full width. */
    margin-block: clamp(32px, 11vw, 100px);
  }

  /* Desktop only.

     On a phone the card is already sized by 92vw and is the right size; it is
     on a wide screen that the 820px cap applied and the card ate most of a
     laptop screen — roughly 516px of card plus ~97px of rotation overhang top
     and bottom — while carrying no information the reader needs. Below 1024px
     nothing here applies and the mobile rendering is untouched.

     The margin is recomputed from the same overhang formula rather than left
     at 100px: at 480px wide the corners only reach ~57px past the box, so the
     old value would have kept the empty space the smaller card was meant to
     give back. */
  @media (min-width: 1024px) {
    .card-tilt {
      width: min(480px, 92vw);
      margin-block: 60px;
    }
  }

  .card-slot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms ease-out;
    pointer-events: none;
  }

  .hero[data-tier='gold'] .card-slot[data-slot='gold'],
  .hero[data-tier='platinum'] .card-slot[data-slot='platinum'],
  .hero[data-tier='infinite'] .card-slot[data-slot='infinite'] {
    opacity: 1;
  }

  .tier-selector {
    display: inline-flex;
    gap: 4px;
    margin-top: 8px;
    padding: 4px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(218, 165, 75, 0.18);
    border-radius: var(--radius-full);
  }

  .tier-option {
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: 8px 20px;
    font-family: inherit;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.66);
    cursor: pointer;
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out;
  }

  /* Gold rather than the brand red: red on dark maroon is barely a change of
     state, and the selected plan has to be unmistakable. Dark text on gold
     measures 9.4:1. */
  .tier-option[aria-checked='true'] {
    background: linear-gradient(150deg, #f0c987 0%, var(--color-brand-gold) 60%, #c08f3c 100%);
    color: #17090a;
  }

  /* The comparison itself */
  .comparison {
    margin: 40px auto 0;
    max-width: var(--container-form);
    text-align: left;
    display: grid;
    gap: 0;
  }

  /* A grid rather than a flex row: Russian labels are long enough that a
     wrapping flex row detaches the value onto its own line and strands it.
     Here the label keeps the left track and wraps within it, and the value
     stays on the right whatever happens. */
