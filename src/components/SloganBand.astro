---
/**
 * The slogan strip at the very top of the page.
 *
 * Two slogans, not one. The market has two halves that want this card for
 * opposite reasons: residents of Russia working around payment limitations,
 * and Russians living abroad who have no such limitation locally and want a
 * financial link back to Russia. One slogan can only speak to one of them.
 *
 * A static site cannot tell which visitor it has, so both are shown and
 * labelled, and the reader self-selects in about a second. Keeping them
 * side by side also makes it obvious the service covers both, which a single
 * line would hide.
 *
 * Deliberately NOT inside the sticky nav: `position: sticky` is bounded by its
 * parent's box, so wrapping this and the nav in a shared <header> would stop
 * the nav sticking past the header's own height. As siblings, the slogan
 * scrolls away and the nav goes on sticking — also the restrained choice,
 * since a permanent bar would eat height on every screen for a line most
 * people read once.
 */
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<div class="slogan-band">
  <ul>
    {
      copy.header.audiences.map((audience) => (
        <li>
          <span class="label">{audience.label}</span>
          <span class="slogan">{audience.slogan}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .slogan-band {
    background-color: var(--color-wash);
    border-bottom: 1px solid var(--color-hairline);
    padding: 10px 24px;
  }

  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--container-text);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 8px;
    min-width: 0;
  }

  .label {
    font-size: var(--text-caption);
    color: var(--color-ash);
    white-space: nowrap;
  }

  .slogan {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    ul {
      flex-direction: row;
      justify-content: center;
      gap: 32px;
    }

    /* A hairline between the two, so they read as two offers rather than one
       run-on sentence. Never a fixed width: the Russian strings are longer. */
    li + li {
      padding-left: 32px;
      border-left: 1px solid var(--color-hairline);
    }
  }
</style>
