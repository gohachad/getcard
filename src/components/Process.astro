---
/**
 * Three steps, one line of explanation each.
 *
 * The previous version ran five steps with a paragraph under each, which made
 * a simple process look like paperwork — the opposite of what the page argues.
 * Anything that needs a paragraph belongs in the FAQ, not here.
 *
 * Step 2 carries the payoff: the card works before the plastic arrives.
 */
import { t, type Locale } from '../i18n';
import Copy from './Copy.astro';
import NoticeCallout from './NoticeCallout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="process section" id="process" aria-labelledby="process-heading">
  <div class="measure">
    <h2 id="process-heading">{copy.process.heading}</h2>

    <ol class="steps">
      {
        copy.process.steps.map((step, index) => (
          <li class="step">
            <span class="marker" aria-hidden="true">
              {index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>
              <Copy text={step.body} />
            </p>
          </li>
        ))
      }
    </ol>

    <div class="tax">
      <NoticeCallout title={copy.process.taxNotice.title}>
        {copy.process.taxNotice.body}
      </NoticeCallout>
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: 600;
    margin: 0 0 48px;
    text-align: center;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }

  .step {
    position: relative;
    padding-left: 52px;
  }

  .marker {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-action);
    color: var(--color-white);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 44px;
    bottom: -32px;
    border-left: 1px solid var(--color-hairline);
  }

  h3 {
    font-size: var(--text-subheading);
    line-height: 36px;
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 600;
    margin: 0;
  }

  .step p {
    margin: 6px 0 0;
    color: var(--color-graphite);
  }

  .tax {
    max-width: var(--container-form);
    margin: 56px auto 0;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 32px;
    }

    /* Titles wrap to two lines in some columns and one in others, so bodies
       are subgrid rows and every description starts on the same line. */
    .step {
      padding-left: 0;
      padding-top: 52px;
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 2;
      align-content: start;
    }

    .step:not(:last-child)::before {
      left: 44px;
      right: -32px;
      top: 18px;
      bottom: auto;
      border-left: none;
      border-top: 1px solid var(--color-hairline);
    }

    h3 {
      line-height: var(--text-subheading--line-height);
    }
  }
</style>
