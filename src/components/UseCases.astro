---
/**
 * The far side of the crossing: the ordinary things that start working
 * again. Three columns, no panels — containment is not needed here and
 * DESIGN.md §5 keeps panels for comparison and grouping only.
 *
 * No third-party brand names appear in this section by rule.
 */
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="uses section" id="uses" aria-labelledby="uses-heading">
  <div class="measure">
    <h2 id="uses-heading">{copy.uses.heading}</h2>
    <ul class="grid">
      {
        copy.uses.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: 600;
    margin: 0 0 40px;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  h3 {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    letter-spacing: var(--text-subheading--letter-spacing);
    font-weight: 600;
    margin: 0;
    /* Decorative accent — --color-signal is never interactive. */
    padding-top: 16px;
    border-top: 1px solid var(--color-signal);
  }

  p {
    margin: 12px 0 0;
    color: var(--color-graphite);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
</style>
