---
/**
 * The card, drawn.
 *
 * Inline SVG — no raster asset, no photography, nothing to download. Carries
 * no bank name, no wordmark, no payment mark and no issuer identity of any
 * kind: a rectangle, a chip, and an abstract number. Per-tier gradients are
 * getcard's own and imitate nobody.
 *
 * This is the page's only loud object and the only thing carrying
 * --shadow-xl. The angle is applied by the parent so the card reads as
 * crossing the frame rather than sitting inside it.
 */

interface Props {
  tier: 'gold' | 'platinum' | 'infinite';
  /** Only the visible card is exposed to assistive tech; the rest are inert. */
  label: string;
  active: boolean;
}

const { tier, label, active } = Astro.props;

// Two stops per tier, plus a sheen band. Warm bronze, cool graphite, deep
// indigo — distinct enough to tell apart at a glance, none of them anyone's
// brand colours.
const palettes = {
  gold: { from: '#8a6a2f', via: '#c9a35c', to: '#6d5122', ink: '#fdf6e6' },
  platinum: { from: '#4a4a4f', via: '#9a9aa2', to: '#35353a', ink: '#f6f6f8' },
  infinite: { from: '#1a1b2e', via: '#3c3f66', to: '#0c0d17', ink: '#eceef8' },
} as const;

const p = palettes[tier];
const uid = `card-${tier}`;
---

<svg
  class="card-render"
  data-tier={tier}
  viewBox="0 0 540 340"
  role="img"
  aria-label={label}
  aria-hidden={active ? undefined : 'true'}
  data-active={active ? '' : undefined}
>
  <defs>
    <linearGradient id={`${uid}-face`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={p.from}></stop>
      <stop offset="55%" stop-color={p.via}></stop>
      <stop offset="100%" stop-color={p.to}></stop>
    </linearGradient>

    <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22"></stop>
      <stop offset="45%" stop-color="#ffffff" stop-opacity="0.02"></stop>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.12"></stop>
    </linearGradient>

    <linearGradient id={`${uid}-chip`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f0dca4"></stop>
      <stop offset="100%" stop-color="#b99a52"></stop>
    </linearGradient>
  </defs>

  <rect width="540" height="340" rx="24" fill={`url(#${uid}-face)`}></rect>
  <rect width="540" height="340" rx="24" fill={`url(#${uid}-sheen)`}></rect>

  <!-- Chip -->
  <rect x="48" y="96" width="66" height="50" rx="8" fill={`url(#${uid}-chip)`}></rect>
  <g stroke={p.to} stroke-opacity="0.5" stroke-width="1.5">
    <line x1="48" y1="113" x2="114" y2="113"></line>
    <line x1="48" y1="129" x2="114" y2="129"></line>
    <line x1="81" y1="96" x2="81" y2="146"></line>
  </g>

  <!-- Contactless mark: generic arcs, not any network's symbol -->
  <g
    stroke={p.ink}
    stroke-opacity="0.6"
    stroke-width="3.5"
    fill="none"
    stroke-linecap="round"
  >
    <path d="M140 106a26 26 0 0 1 0 30"></path>
    <path d="M154 98a40 40 0 0 1 0 46"></path>
  </g>

  <!-- Abstract number placeholder — no digits invented -->
  <g fill={p.ink} fill-opacity="0.85">
    {
      [0, 1, 2, 3].map((group) =>
        [0, 1, 2, 3].map((dot) => (
          <circle cx={52 + group * 118 + dot * 21} cy="216" r="6.5" />
        ))
      )
    }
  </g>

  <!-- Abstract holder / expiry blocks, deliberately unreadable -->
  <g fill={p.ink} fill-opacity="0.4">
    <rect x="48" y="264" width="150" height="10" rx="5"></rect>
    <rect x="214" y="264" width="62" height="10" rx="5"></rect>
  </g>
</svg>

<style>
  .card-render {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
    /* The page's only shadow — DESIGN.md §4. */
    box-shadow: var(--shadow-xl);
  }
</style>
