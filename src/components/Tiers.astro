---
/**
 * The three plans, side by side.
 *
 * Gold is the baseline and carries the one filled button, because it is the
 * card most people take. No plan is badged "recommended" — that decision is
 * not made yet, and a badge would make it for us.
 *
 * Values better than Gold read in --color-success with a check, the same
 * treatment the hero comparison uses, so an upgrade looks identical wherever
 * it appears. Nothing is highlighted on Gold itself: it is what the others are
 * measured against.
 *
 * Spec rows align across all three panels with subgrid rather than fixed
 * heights, so Russian copy that wraps moves the same row in every column.
 */
import { t, type Locale } from '../i18n';
import Copy from './Copy.astro';
import NoticeCallout from './NoticeCallout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const { comparison } = copy;
const { labels, shared } = comparison;

const rowsFor = (tier: (typeof comparison.tiers)[number]) => [
  { key: 'annualFee', label: labels.annualFee, value: tier.annualFee },
  { key: 'dailyLimit', label: labels.dailyLimit, value: tier.dailyLimit },
  { key: 'lounge', label: labels.lounge, value: tier.lounge },
  { key: 'personalManager', label: labels.personalManager, value: tier.personalManager },
  { key: 'limitIncrease', label: labels.limitIncrease, value: tier.limitIncrease },
  { key: 'expressIssue', label: labels.expressIssue, value: tier.expressIssue },
  { key: 'minBalance', label: labels.minBalance, value: tier.minBalance },
  { key: 'dailyTransactions', label: labels.dailyTransactions, value: shared.dailyTransactions },
  { key: 'atmFee', label: labels.atmFee, value: shared.atmFee },
  { key: 'crossCurrency', label: labels.crossCurrency, value: shared.crossCurrency },
  { key: 'currencies', label: labels.currencies, value: shared.currencies },
  { key: 'wallets', label: labels.wallets, value: shared.wallets },
];

// Qualifiers that belong to a specific benefit, shown only on the panel that
// actually carries it.
const notesFor = (tier: (typeof comparison.tiers)[number]) =>
  [
    tier.advantages.includes('lounge') ? comparison.loungeNote : null,
    tier.advantages.includes('limitIncrease') ? comparison.limitIncreaseNote : null,
  ].filter((note): note is string => note !== null);
---

<section class="tiers section" id="tiers" aria-labelledby="tiers-heading">
  <div class="measure">
    <h2 id="tiers-heading">{copy.tiers.heading}</h2>
    <p class="intro">{copy.tiers.intro}</p>

    {/* Three prices, not a converter. Setting the attribute on <html> lets the
        hero comparison follow the same choice from one control. */}
    <div class="currency-switch" role="radiogroup" aria-label={comparison.currencyLabel}>
      {
        comparison.currencies.map((currency, index) => (
          <button
            type="button"
            role="radio"
            class="currency-option"
            data-currency-option={currency.id}
            aria-checked={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {currency.label}
          </button>
        ))
      }
    </div>

    {/* Above the figures, not below: someone who reads the numbers and stops
        should already know which of them are provisional. */}
    <div class="notice">
      <NoticeCallout title={copy.tiers.unverifiedTitle} variant="warning">
        <Copy text={copy.tiers.unverifiedNotice} />
      </NoticeCallout>
    </div>

    <ul class="tiers-grid">
      {
        comparison.tiers.map((tier, index) => (
          <li class="panel tier-panel">
            <h3>
              {tier.name}
              {index === 0 && <span class="badge">{copy.tiers.baselineLabel}</span>}
            </h3>

            {/* Our fee is the headline number, not the bank's annual fee: it is
                what the visitor is actually deciding to pay. All three
                currencies render; the switcher picks one. */}
            <p class="fee">
              {comparison.currencies.map((currency) => (
                <span class="fee-value" data-currency={currency.id}>
                  <Copy text={comparison.serviceFeeBy[currency.id as 'rub' | 'usd' | 'eur']} />
                </span>
              ))}
              <span class="fee-unit">{copy.tiers.serviceFeeLabel}</span>
            </p>

            <dl class="specs">
              {rowsFor(tier).map((row) => {
                const isAdvantage = tier.advantages.includes(row.key);
                return (
                  <div class="spec-row">
                    <dt>{row.label}</dt>
                    <dd data-advantage={isAdvantage ? '' : undefined}>
                      {isAdvantage && (
                        <svg class="check" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                          <path
                            d="M4 10.5l4 4 8-9"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                      <Copy text={row.value} />
                    </dd>
                  </div>
                );
              })}
            </dl>

            {/* Qualifiers sit with the panel that actually carries the
                benefit, not as fine print at the bottom of the section. The
                element is always present so all three panels keep the same
                subgrid row structure; it simply has no children on Gold. */}
            <p class="panel-notes">
              {notesFor(tier).map((note) => (
                <span>{note}</span>
              ))}
            </p>

            <a class={index === 0 ? 'pill-filled' : 'pill-outlined'} href="#process">
              {copy.tiers.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Sets the currency on <html> so the hero comparison and the plan panels
  // both follow one control. Nothing is converted at runtime — all three
  // prices are in the DOM and this only chooses which is visible, so the page
  // still shows a correct price with JavaScript disabled.
  const group = document.querySelector<HTMLElement>('.currency-switch');

  if (group) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-currency-option]'));

    const select = (index: number, moveFocus = false) => {
      const chosen = options[index];
      if (!chosen) return;

      document.documentElement.dataset.currency = chosen.dataset.currencyOption;
      options.forEach((option, i) => {
        option.setAttribute('aria-checked', String(i === index));
        option.tabIndex = i === index ? 0 : -1;
      });

      if (moveFocus) chosen.focus();
    };

    // The default has to be applied on load: the markup ships with rub checked
    // but the attribute that drives the CSS lives on <html>.
    select(0);

    options.forEach((option, index) => option.addEventListener('click', () => select(index)));

    group.addEventListener('keydown', (event) => {
      const current = options.findIndex((o) => o.tabIndex === 0);
      if (current < 0) return;
      const step =
        event.key === 'ArrowRight' || event.key === 'ArrowDown'
          ? 1
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
            ? -1
            : 0;
      if (step === 0) return;
      event.preventDefault();
      select((current + step + options.length) % options.length, true);
    });
  }
</script>

<style>
  h2 {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: 600;
    margin: 0;
    text-align: center;
  }

  .intro {
    max-width: var(--container-form);
    margin: 20px auto 32px;
    color: var(--color-graphite);
    text-align: center;
  }

  .notice {
    max-width: var(--container-form);
    margin: 0 auto 40px;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tier-panel {
    display: grid;
    gap: 0;
    align-content: start;
  }

  h3 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
    margin: 0;
  }

  .badge {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-graphite);
    border: 1px solid var(--color-signal);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    white-space: nowrap;
  }

  .currency-switch {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    margin: 0 auto 32px;
    padding: 4px;
    background-color: var(--color-pebble);
    border-radius: var(--radius-full);
  }

  .currency-option {
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: 8px 22px;
    font-family: inherit;
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-graphite);
    cursor: pointer;
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out;
  }

  .currency-option[aria-checked='true'] {
    background-color: var(--color-action);
    color: var(--color-white);
  }

  /* All three prices occupy the same cell so the panel never changes height
     when the currency changes. */
  .fee-value {
    grid-area: 1 / 1;
    display: none;
  }

  :global([data-currency='rub']) .fee-value[data-currency='rub'],
  :global([data-currency='usd']) .fee-value[data-currency='usd'],
  :global([data-currency='eur']) .fee-value[data-currency='eur'] {
    display: inline;
  }

  .fee {
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: 600;
    margin: 12px 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fee-unit {
    font-size: var(--text-body-sm);
    font-weight: 400;
    letter-spacing: var(--text-body-sm--letter-spacing);
    color: var(--color-ash);
  }

  .specs {
    margin: 20px 0 0;
    padding: 0;
  }

  .spec-row {
    padding-block: 12px;
    border-top: 1px solid var(--color-hairline);
  }

  .spec-row dt {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-ash);
  }

  .spec-row dd {
    margin: 2px 0 0;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  /* Better than the baseline plan. Same green and same check as the hero
     comparison and the benefit list. */
  .spec-row dd[data-advantage] {
    color: var(--color-success);
    font-weight: 600;
  }

  .check {
    flex: 0 0 auto;
    align-self: center;
  }

  .panel-notes {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-ash);
  }

  .tier-panel > .pill-filled,
  .tier-panel > .pill-outlined {
    margin-top: 24px;
    align-self: end;
    justify-self: stretch;
  }

  @media (min-width: 768px) {
    /* 16 rows: name, fee, 12 spec rows, spacer, button. Panels and their spec
       lists both inherit these tracks, so every row lines up across all three
       columns however the copy wraps. */
    .tiers-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto repeat(12, auto) 1fr auto;
      gap: 20px;
    }

    .tier-panel {
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
    }

    .specs {
      grid-row: span 12;
      display: grid;
      grid-template-rows: subgrid;
    }

    .tier-panel > .pill-filled,
    .tier-panel > .pill-outlined {
      grid-row: -2 / -1;
    }
  }
</style>
