---
/**
 * The plans — the only place on the page that states them.
 *
 * The section is split by what is true of the content: what differs between
 * plans is in the three panels, what is the same on all three is stated once
 * in the strip beneath them. Four of the eleven terms are identical on every
 * plan, and printing them three times says nothing three times.
 *
 * Each panel is headed by the face that plan actually issues — the one
 * difference that cannot be written as a row. The section takes the hero's
 * dark ground, so the page has two weighted moments, the promise and the
 * choice, with the argument in the light between them.
 *
 * It is dense on purpose: the whole choice has to sit on one screen, or
 * choosing means scrolling a comparison and holding it in your head. Label
 * and value share a line, the face and the price share a band, and the
 * heading shares one with the currency control.
 */
import CardRender from './CardRender.astro';
import Copy from './Copy.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const { comparison } = copy;
const { labels, shared } = comparison;

// The rows that change from plan to plan. Everything absent from this list is
// identical on all three and is stated once, in the strip under the panels.
const DIFFERING = [
  'annualFee',
  'dailyLimit',
  'expressIssue',
  'minBalance',
  'lounge',
  'personalManager',
  'limitIncrease',
] as const;

// An empty value still means the plan does not carry the benefit and the row
// is dropped — a column of dashes reads as an argument against Gold, which is
// the plan most people should take.
const rowsFor = (tier: (typeof comparison.tiers)[number]) =>
  DIFFERING.map((key) => ({ key, label: labels[key], value: tier[key] })).filter(
    (row) => row.value !== ''
  );

const NOTE_MARKERS: Record<string, string> = {
  lounge: '*',
  limitIncrease: '**',
};

const notesFor = (tier: (typeof comparison.tiers)[number]) =>
  [
    tier.advantages.includes('lounge') ? { key: 'lounge', text: comparison.loungeNote } : null,
    tier.advantages.includes('limitIncrease')
      ? { key: 'limitIncrease', text: comparison.limitIncreaseNote }
      : null,
  ].filter((note): note is { key: string; text: string } => note !== null);

const noteId = (tierId: string, key: string) => `plan-note-${tierId}-${key}`;

const sameRows = (['dailyTransactions', 'atmFee', 'currencies', 'wallets'] as const).map((key) => ({
  key,
  label: labels[key],
  value: shared[key],
}));
---

<section class="plans section" id="tiers" aria-labelledby="plans-heading">
  <div class="plans-measure">
    {/* Heading on the left, the page's one currency control on the right:
        one band rather than two stacked and centred. */}
    <div class="plans-head">
      <div>
        <h2 id="plans-heading">{copy.tiers.heading}</h2>
        <p class="intro">{copy.tiers.intro}</p>
      </div>

      <div class="currency-switch" role="radiogroup" aria-label={comparison.currencyLabel}>
      {
        comparison.currencies.map((currency, index) => (
          <button
            type="button"
            role="radio"
            class="currency-option"
            data-currency-option={currency.id}
            aria-checked={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {currency.label}
          </button>
          ))
        }
      </div>
    </div>

    <ul class="plan-grid">
      {
        comparison.tiers.map((tier, index) => (
          <li class="plan" data-tier={tier.id}>
            {/* Face, name and price on one band — three lines of the same
                thing, which is which plan this is and what it costs. */}
            <div class="plan-head">
              <div class="face">
                <CardRender
                  tier={tier.id as 'gold' | 'platinum' | 'infinite'}
                  label={`${copy.hero.cardAlt} — ${tier.name}`}
                  active={true}
                />
              </div>

              <div class="plan-id">
                <h3>
                  {tier.name}
                  {index === 0 && <span class="badge">{copy.tiers.baselineLabel}</span>}
                </h3>

                <p class="fee">
                  {comparison.currencies.map((currency) => (
                    <span class="fee-value" data-currency={currency.id}>
                      <Copy text={tier.serviceFeeBy[currency.id as 'rub' | 'usd' | 'eur' | 'aed']} />
                    </span>
                  ))}
                </p>
                <p class="fee-unit">{copy.tiers.serviceFeeLabel}</p>
              </div>
            </div>

            <dl class="specs">
              {rowsFor(tier).map((row) => {
                const isAdvantage = tier.advantages.includes(row.key);
                const marker = notesFor(tier).some((note) => note.key === row.key)
                  ? NOTE_MARKERS[row.key]
                  : null;
                return (
                  <div class="spec-row">
                    <dt>{row.label}</dt>
                    <dd
                      data-advantage={isAdvantage ? '' : undefined}
                      aria-describedby={marker ? noteId(tier.id, row.key) : undefined}
                    >
                      {isAdvantage && (
                        <svg class="check" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                          <path
                            d="M4 10.5l4 4 8-9"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                      {isAdvantage && <span class="sr-only">{copy.tiers.advantageLabel}</span>}
                      <span class="spec-value">
                        <Copy text={row.value} />
                        {marker && (
                          <sup class="note-marker" aria-hidden="true">
                            {marker}
                          </sup>
                        )}
                      </span>
                    </dd>
                  </div>
                );
              })}
            </dl>

            {notesFor(tier).length > 0 && (
              <p class="plan-notes">
                {notesFor(tier).map((note) => (
                  <span id={noteId(tier.id, note.key)}>
                    <span class="note-marker" aria-hidden="true">
                      {NOTE_MARKERS[note.key]}
                    </span>
                    {note.text}
                  </span>
                ))}
              </p>
            )}

            <a
              class={index === 0 ? 'pill-filled' : 'pill-outlined'}
              href={`https://app.getcard.kg/order?tier=${tier.id}&lang=${locale}`}
            >
              {copy.tiers.cta}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Everything the three plans share, printed once for the whole page
        rather than three times inside the panels and a fourth time in the
        hero. */}
    <div class="same">
      <p class="same-heading">{copy.tiers.sameHeading}</p>
      <dl class="same-list">
        {
          sameRows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>
                <Copy text={row.value} />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  // Same one-attribute mechanism the live site uses: nothing is converted at
  // runtime, all four prices are in the DOM and this picks which is visible.
  const group = document.querySelector<HTMLElement>('.plans .currency-switch');

  if (group) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-currency-option]'));

    const select = (index: number, moveFocus = false) => {
      const chosen = options[index];
      if (!chosen) return;
      document.documentElement.dataset.currency = chosen.dataset.currencyOption;
      options.forEach((option, i) => {
        option.setAttribute('aria-checked', String(i === index));
        option.tabIndex = i === index ? 0 : -1;
      });
      if (moveFocus) chosen.focus();
    };

    select(0);
    options.forEach((option, index) => option.addEventListener('click', () => select(index)));

    group.addEventListener('keydown', (event) => {
      const current = options.findIndex((o) => o.tabIndex === 0);
      if (current < 0) return;
      const step =
        event.key === 'ArrowRight' || event.key === 'ArrowDown'
          ? 1
          : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
            ? -1
            : 0;
      if (step === 0) return;
      event.preventDefault();
      select((current + step + options.length) % options.length, true);
    });
  }
</script>

<style>
  /* The second dark band on the page, and the last one. The same ground as
     the hero so the two read as one material, but flatter and without the
     engraving: the three card faces are the only loud objects here, and the
     texture behind them would be a second voice. */
  .plans {
    position: relative;
    isolation: isolate;
    --ground: #150a0b;
    background:
      radial-gradient(54rem 22rem at 50% 34%, rgba(218, 165, 75, 0.13), transparent 68%),
      linear-gradient(to bottom, #100708 0%, var(--ground) 46%, #140a0c 100%);
    border-block: 1px solid rgba(218, 165, 75, 0.38);
    color: var(--color-white);
  }

  .plans {
    padding-block: 24px;
  }

  .plans-measure {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .plans-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    text-align: center;
  }

  h2 {
    margin: 0;
    font-size: var(--text-heading-sm);
    line-height: var(--text-heading-sm--line-height);
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
  }

  .intro {
    max-width: 46ch;
    margin: 6px 0 0;
    font-size: var(--text-body-sm);
    color: rgba(255, 255, 255, 0.72);
  }

  .currency-switch {
    display: flex;
    flex: none;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    margin: 0;
    padding: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(218, 165, 75, 0.28);
    border-radius: var(--radius-full);
  }

  .currency-option {
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: 6px 18px;
    font-family: inherit;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    cursor: pointer;
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out;
  }

  .currency-option[aria-checked='true'] {
    background-color: var(--color-brand-gold);
    color: #241505;
  }

  .plan-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Glass over the ground rather than a white card: a white panel here would
     punch three holes in the band and undo the reason for going dark. */
  .plan {
    display: flex;
    flex-direction: column;
    padding: 16px 18px 18px;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.075),
      rgba(255, 255, 255, 0.035)
    );
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
  }

  /* Gold is the baseline and the plan most people should take, so it is the
     one panel with a lit edge — the same job the filled button does. */
  .plan[data-tier='gold'] {
    border-color: rgba(218, 165, 75, 0.5);
  }

  /* The face is a plan attribute here, not the hero's object: small, flat,
     no tilt, no shadow, sized to sit beside the name rather than above it. */
  .plan-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .face {
    flex: none;
    width: 84px;
  }

  .plan-id {
    min-width: 0;
  }

  .face :global(.card-render) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
  }

  h3 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
    font-weight: 600;
  }

  .badge {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-brand-gold);
    border: 1px solid rgba(218, 165, 75, 0.5);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    white-space: nowrap;
  }

  .fee {
    display: grid;
    margin: 4px 0 0;
    font-size: var(--text-subheading);
    line-height: 1.1;
    letter-spacing: var(--text-heading-sm--letter-spacing);
    font-weight: 600;
  }

  /* All four prices occupy one cell, so switching currency never changes the
     panel's height. */
  .fee-value {
    grid-area: 1 / 1;
    display: none;
  }

  :global([data-currency='rub']) .fee-value[data-currency='rub'],
  :global([data-currency='usd']) .fee-value[data-currency='usd'],
  :global([data-currency='eur']) .fee-value[data-currency='eur'],
  :global([data-currency='aed']) .fee-value[data-currency='aed'] {
    display: inline;
  }

  .fee-unit {
    margin: 2px 0 0;
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.6);
  }

  .specs {
    margin: 14px 0 0;
    padding: 0;
  }

  /* Label and value on one line: seven rows have to fit without turning the
     panel into a page of its own, and side by side they read as a spec sheet,
     which is what they are. */
  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-block: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spec-row dt {
    font-size: var(--text-body-sm);
    color: rgba(255, 255, 255, 0.58);
  }

  .spec-row dd {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin: 0;
    text-align: right;
    font-size: var(--text-body-sm);
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Green light enough to carry on this ground — the flat --color-success is
     for the light sections and disappears here. */
  .spec-row dd[data-advantage] {
    color: #6fcf87;
    font-weight: 600;
  }

  /* The check is the only thing marking an advantage for a sighted reader,
     and it is decorative to assistive tech, so the label is read instead. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .check {
    flex: none;
    width: 13px;
    height: 13px;
    color: #6fcf87;
    translate: 0 2px;
  }

  .note-marker {
    color: var(--color-brand-gold);
    font-weight: 600;
  }

  .spec-value .note-marker {
    font-size: 0.75em;
    line-height: 1;
    margin-left: 1px;
  }

  .plan-notes {
    display: grid;
    gap: 3px;
    margin: 10px 0 0;
    font-size: var(--text-caption);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.55);
  }

  .plan-notes .note-marker {
    margin-right: 3px;
  }

  .plan > .pill-filled,
  .plan > .pill-outlined {
    margin-top: auto;
    padding-block: 9px;
    font-size: var(--text-body-sm);
  }

  /* Deliberately no rule for a notes-then-button pair: it would beat the auto
     margin above and drop that plan's button off the shared line. */
  .plan-notes {
    margin-bottom: 14px;
  }

  /* On this ground the outlined button's ink is unreadable, so the two
     secondary plans get a gold outline instead of the site's blue one. */
  .plan > .pill-outlined {
    color: var(--color-brand-gold);
    border-color: rgba(218, 165, 75, 0.55);
  }

  /* Everything the plans share, said once. It is deliberately not a panel:
     it is the floor all three stand on, so it reads as a rule under them
     rather than as a fourth plan. */
  .same {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(218, 165, 75, 0.3);
  }

  .same-heading {
    margin: 0 0 10px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-gold);
  }

  .same-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px 28px;
    margin: 0;
  }

  .same-list dt {
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.55);
  }

  .same-list dd {
    margin: 1px 0 0;
    font-size: var(--text-body-sm);
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .same-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .plans-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
      text-align: left;
    }

    .plan-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .same-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
