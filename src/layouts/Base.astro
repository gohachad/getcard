---
import '../styles/global.css';
// Imported as URLs so Vite fingerprints them and applies the base path; the
// same files are referenced by @font-face in global.css.
import interLatin from '../fonts/inter-latin-wght-normal.woff2?url';
import interCyrillic from '../fonts/inter-cyrillic-wght-normal.woff2?url';
import { t, htmlLang, canonicalPath, LOCALES, type Locale } from '../i18n';
import { legal } from '../config/placeholders';

interface Props {
  locale: Locale;
  /** Overrides the landing page's title and description on a sub-page. */
  title?: string;
  description?: string;
  /**
   * Keeps a page out of the index. Used by the public offer: it is a contract
   * that has to be reachable, not a page we want ranking for "карта VISA".
   */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const copy = t(locale);

const pageTitle = title ?? copy.meta.title;
const pageDescription = description ?? copy.meta.description;

// Sub-pages are their own URL, and hreflang must point at the same document in
// the other locale rather than at the landing page.
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sub = path.replace(base, '').replace(/^\/(ru|en)/, '').replace(/^\/|\/$/g, '');

// Public identity of the page, which is the production domain — never the
// GitHub Pages base path. See canonicalPath() in src/i18n.
const site = Astro.site ?? new URL('https://getcard.kg');
const origin = site.origin;
const absolute = (locale: Locale) =>
  new URL(sub ? `${canonicalPath(locale)}${sub}/` : canonicalPath(locale), site).href;

/**
 * Structured data — three graphs, all of them things a search engine can act
 * on rather than decoration:
 *
 *   Organization  who is behind the site, with the legal entity that already
 *                 appears in the footer, so the two cannot disagree
 *   WebSite       the site itself and the language it is in
 *   FAQPage       the questions from <Faq>, read from the same copy the page
 *                 renders. Answers shown to a searcher must match the page,
 *                 which is exactly what reading them from one source gives us
 *
 * Nothing here claims a rating, a review or a price that is not on the page.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'getcard',
      legalName: legal.entityName,
      taxID: legal.inn,
      url: origin,
      logo: `${origin}/favicon-512.png`,
      image: `${origin}/og.png`,
      description: copy.meta.description,
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: origin,
      name: 'getcard',
      inLanguage: htmlLang[locale],
      publisher: { '@id': `${origin}/#organization` },
    },
    // The FAQ graph describes the landing page, so it is emitted only there —
    // claiming an FAQPage on the public offer would be a lie to a crawler.
    ...(sub
      ? []
      : [
          {
            '@type': 'FAQPage',
            '@id': `${absolute(locale)}#faq`,
            inLanguage: htmlLang[locale],
            mainEntity: copy.faq.items.map((item) => ({
              '@type': 'Question',
              name: item.q,
              acceptedAnswer: { '@type': 'Answer', text: item.a },
            })),
          },
        ]),
  ],
};
---

<!doctype html>
{/* data-currency ships as rub so the price renders correctly with JavaScript
    disabled; the switcher only changes this attribute. */}
<html lang={htmlLang[locale]} data-currency="rub">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {/* Indexing is the default, but saying so explicitly also carries the
        preview limits: a large image and an unlimited snippet, which is what
        makes a result worth clicking rather than a title and one line. */}
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />

    <link rel="canonical" href={absolute(locale)} />
    {
      LOCALES.map((other) => (
        <link rel="alternate" hreflang={htmlLang[other]} href={absolute(other)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute('ru')} />

    <!-- Both subsets are needed on first paint in either locale: the RU build
         carries Latin figures and the word "getcard"; the EN build carries none
         of the Cyrillic, but preloading both keeps the switcher instant. -->
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    {
      locale === 'ru' && (
        <link rel="preload" as="font" type="font/woff2" href={interCyrillic} crossorigin />
      )
    }

    {/* The logo mark, trimmed to its own ink and centred — the 512 master
        has margins that shrink it to nothing at tab size.

        There is deliberately no favicon.svg. The one that used to sit here was
        the Astro starter's glyph, and because browsers PREFER an SVG icon over
        any PNG offered beside it, that glyph is what every tab actually showed
        — the PNGs below were never reached. The mark is a raster with a
        gradient and a guilloche, so there is no faithful SVG of it to put
        back; the .ico carries 32 and 48 for the bare /favicon.ico request. */}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-512.png`} sizes="512x512" type="image/png" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32 48x48" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    {/* Search console verification.
        TODO: paste the code from Google Search Console into content="" below.
        Verify the https://getcard.kg/ru/ URL-prefix property, or use DNS
        verification for the whole domain — `/` answers with a 301, so a
        meta tag placed there would never be seen by the verifier. */}
    <meta name="google-site-verification" content="" />

    {/* TODO: paste the code from Yandex Webmaster into content="" below.
        Same note as above about which URL to verify. */}
    <meta name="yandex-verification" content="" />

    {/* Social preview. This is what Telegram and VK render when the link is
        pasted into a chat, which is where most of this traffic will come from. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="getcard" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
    {/* Absolute URL and explicit dimensions: Telegram and VK will not scale an
        image they have to fetch and measure first. */}
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${origin}/og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a href="#main" class="skip-link">{copy.a11y.skipToContent}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -150%;
    z-index: 100;
    padding: 11px 15px;
    background-color: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    color: var(--color-link);
    font-size: var(--text-body-sm);
    text-decoration: none;
    transition: translate 150ms ease-out;
  }

  .skip-link:focus-visible {
    translate: -50% 8px;
  }
</style>
